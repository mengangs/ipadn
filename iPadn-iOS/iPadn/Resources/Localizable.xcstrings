    "同步后可在这里查找并下载你获取过的应用。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After syncing, find and download the apps you've acquired here."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同步后可在这里查找并下载你获取过的应用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "同步後可在這裡查詢並下載你取得過的應用。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同期すると、入手した App をここで探してダウンロードできます。"
