    "验证已取消，请重试": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Verification cancelled. Try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "验证已取消，请重试"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "驗證已取消，請重試"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認をキャンセルしました。もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "확인이 취소되었습니다. 다시 시도하십시오."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверка отменена. Повторите попытку."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Verificación cancelada. Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérification annulée. Réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestätigung abgebrochen. Versuche es erneut."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verificação cancelada. Tente de novo."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم إلغاء التحقق. حاول مرة أخرى."
          }
        }
      }
    },
    "验证已超过 3 分钟，已停止本次操作。请保持应用在前台后重试。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Verification took over 3 minutes and was stopped. Keep the app in the foreground and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "验证已超过 3 分钟，已停止本次操作。请保持应用在前台后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "驗證已超過 3 分鐘，已停止本次操作。請保持應用在前臺後重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認が 3 分を超えたため停止しました。App を前面に表示したままもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "확인이 3분을 넘어 중단되었습니다. 앱을 화면에 띄워 둔 채 다시 시도하십시오."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверка длилась больше 3 минут и была остановлена. Держите приложение на экране и повторите попытку."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La verificación tardó más de 3 minutos y se detuvo. Mantén la app en primer plano e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La vérification a duré plus de 3 minutes et a été arrêtée. Gardez l’app au premier plan et réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Bestätigung dauerte über 3 Minuten und wurde abgebrochen. Lass die App im Vordergrund und versuche es erneut."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A verificação levou mais de 3 minutos e foi interrompida. Mantenha o app em primeiro plano e tente de novo."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استغرق التحقق أكثر من 3 دقائق وتم إيقافه. أبقِ التطبيق في المقدمة وحاول مرة أخرى."
          }
        }
      }
    },
