          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifier et connecter TestFlight"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestätigen & TestFlight verbinden"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verificar e conectar TestFlight"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التحقق والاتصال بـ TestFlight"
          }
        }
      }
    },
    "验证完成后会话将安全保存在钥匙串中，下次进入或切换账号自动恢复，无需重复登录。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "验证完成后会话将安全保存在钥匙串中，下次进入或切换账号自动恢复，无需重复登录。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Once verified, your session is stored securely in Keychain and restored automatically when reopening or switching accounts."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "驗證完成後工作階段將安全儲存在鑰匙圈中，下次進入或切換帳號自動恢復，無需重複登入。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "認証後、セッションはキーチェーンに安全に保存され、次回起動やアカウント切替時に自動復元されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인증 후 세션은 키체인에 안전하게 저장되며 다시 열거나 계정을 전환할 때 자동으로 복원됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После проверки сессия безопасно сохраняется в Связке ключей и восстанавливается автоматически при открытии или смене аккаунта."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una vez verificada, tu sesión se guarda en el Llavero y se restaura automáticamente al volver o cambiar de cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une fois vérifiée, la session est enregistrée dans le Trousseau et restaurée automatiquement à l'ouverture ou au changement de compte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach der Bestätigung wird die Sitzung sicher im Schlüsselbund gespeichert und beim Öffnen oder Accountwechsel automatisch wiederhergestellt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Após a verificação, a sessão é salva com segurança nas Chaves e restaurada automaticamente ao reabrir ou trocar de conta."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بعد التحقق، تُحفظ الجلسة بأمان في سلسلة المفاتيح وتُستعاد تلقائيًا عند الفتح أو تبديل الحساب."
          }
        }
      }
    },
    "当前 Apple 账号尚未加入任何 TestFlight 测试项目，可尝试刷新或点右上角头像切换其他账号。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前 Apple 账号尚未加入任何 TestFlight 测试项目，可尝试刷新或点右上角头像切换其他账号。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Apple Account has not joined any TestFlight betas yet. Try refreshing or tap the top-right avatar to switch accounts."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前 Apple 帳號尚未加入任何 TestFlight 測試專案，可嘗試重新整理或點右上角頭像切換其他帳號。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Apple アカウントはまだ TestFlight ベータに参加していません。更新するか右上のアイコンからアカウントを切り替えてみてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Apple 계정은 아직 TestFlight 베타에 참여하지 않았습니다. 새로고침하거나 오른쪽 상단 아바타를 눌러 계정을 전환해 보세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот аккаунт Apple ещё не участвует в TestFlight. Обновите список или нажмите на аватар в правом верхнем углу для смены аккаунта."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta cuenta de Apple aún no participa en betas de TestFlight. Intenta actualizar o toca el avatar superior derecho para cambiar de cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce compte Apple ne participe à aucune bêta TestFlight. Actualisez ou touchez l'avatar en haut à droite pour changer de compte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Apple Account nimmt an keinen TestFlight-Betas teil. Aktualisiere oder tippe oben rechts auf das Profilbild, um den Account zu wechseln."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta conta Apple ainda não participa de betas do TestFlight. Tente atualizar ou toque no avatar no canto superior direito para trocar de conta."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم ينضم حساب Apple هذا إلى أي اختبارات TestFlight بعد. جرّب التحديث أو اضغط على الصورة الرمزية في الأعلى لتبديل الحساب."
          }
        }
      }
    },
    "点按应用可查看测试内容与详情；安装包自带有效签名，可直接安装或按需解密导出。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按应用可查看测试内容与详情；安装包自带有效签名，可直接安装或按需解密导出。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap an app to view What to Test and details. Packages carry a valid signature and can be installed directly or optionally decrypted."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點按應用可檢視測試內容與詳情；安裝包自帶有效簽署，可直接安裝或依需求解密匯出。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "App をタップするとテスト内容と詳細を表示できます。パッケージは有効な署名を含み、直接インストールまたは任意で復号できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱을 탭하여 테스트 내용과 상세 정보를 볼 수 있습니다. 패키지는 유효한 서명을 포함하며 바로 설치하거나 필요 시 복호화할 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите на приложение, чтобы посмотреть описание и изменения. Пакеты подписаны — их можно сразу установить или расшифровать."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca una app para ver qué probar y los detalles. Los paquetes incluyen firma válida y pueden instalarse directamente o descifrarse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez une app pour voir les nouveautés et les détails. Les paquets sont valides et peuvent être installés directement ou déchiffrés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf eine App, um Testinhalte und Details anzuzeigen. Pakete sind gültig signiert und können direkt installiert oder optional entschlüsselt werden."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em um app para ver o que testar e detalhes. Os pacotes têm assinatura válida e podem ser instalados diretamente ou descriptografados."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على أي تطبيق لعرض تفاصيل الاختبار؛ تحمل الحزم توقيعًا صالحًا ويمكن تثبيتها مباشرة أو فك تشفيرها اختياريًا."
          }
        }
      }
    },
    "会话已过期，请重新验证后再下载": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会话已过期，请重新验证后再下载"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Session expired. Re-verify before downloading."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "工作階段已過期，請重新驗證後再下載"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セッションの期限が切れました。再認証してからダウンロードしてください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세션이 만료되었습니다. 다시 인증한 후 다운로드하세요"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сессия истекла, подтвердите аккаунт перед загрузкой"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sesión caducó; vuelve a verificar antes de descargar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Session expirée, veuillez revérifier avant de télécharger"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sitzung abgelaufen, bitte vor dem Download erneut bestätigen"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sessão expirada; verifique novamente antes de baixar"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهت الجلسة، يرجى إعادة التحقق قبل التنزيل"
          }
        }
      }
    },
    "TestFlight 会话已过期，请重新验证。已下载的本地安装包仍可安装或分享。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "TestFlight 会话已过期，请重新验证。已下载的本地安装包仍可安装或分享。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your TestFlight session expired. Re-verify to refresh or download. Packages already downloaded locally can still be installed or shared."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "TestFlight 工作階段已過期，請重新驗證。已下載的本機安裝包仍可安裝或分享。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "TestFlight セッションの有効期限が切れました。再認証してください。ローカルに保存済みのパッケージは引き続きインストール・共有できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "TestFlight 세션이 만료되었습니다. 다시 인증해 주세요. 로컬에 다운로드된 패키지는 계속 설치하거나 공유할 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сессия TestFlight истекла, подтвердите аккаунт снова. Скачанные пакеты по-прежнему можно установить или отправить."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sesión de TestFlight ha caducado; vuelve a verificar. Los paquetes descargados siguen disponibles para instalar o compartir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La session TestFlight a expiré ; veuillez revérifier. Les paquets téléchargés restent installables ou partageables."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine TestFlight-Sitzung ist abgelaufen. Bitte erneut bestätigen. Bereits geladene Pakete können weiterhin installiert oder geteilt werden."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A sessão do TestFlight expirou; verifique novamente. Os pacotes já baixados continuam disponíveis para instalar ou compartilhar."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهت جلسة TestFlight، يرجى إعادة التحقق. لا يزال بالإمكان تثبيت الحزم المحمّلة محليًا أو مشاركتها."
          }
        }
      }
    },
