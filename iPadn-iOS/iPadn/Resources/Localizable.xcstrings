            "state": "translated",
            "value": "Nach dem Synchronisieren findest und lädst du hier deine Apps."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Depois de sincronizar, encontre e baixe aqui os apps que você obteve."
