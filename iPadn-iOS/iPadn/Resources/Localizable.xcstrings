    "请在 Safari 中确认安装，然后回到 iPadn 等待完成。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm the installation in Safari, then return to iPadn and wait."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在 Safari 中确认安装，然后回到 iPadn 等待完成。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
