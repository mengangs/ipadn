        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im App Store sind für diese App keine In-App-Käufe aufgeführt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A App Store não mostra compras dentro do app para este app."
          }
        },
        "ar": {
