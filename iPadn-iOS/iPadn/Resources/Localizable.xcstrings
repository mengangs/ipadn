          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez les détails techniques pour voir les fichiers restants ; retéléchargez l'IPA d'origine et réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
