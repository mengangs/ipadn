    "验证期间账号已改变，请重新选择下载账号": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The account changed during verification. Choose the download account again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "验证期间账号已改变，请重新选择下载账号"
          }
        },
        "zh-Hant": {
          "stringUnit": {
