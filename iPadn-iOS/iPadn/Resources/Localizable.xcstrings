        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "解密不可用：签名缺少 App Group"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "解密不可用：簽名缺少 App Group"
          }
        }
      }
    },
    "请用包含 App Group 权限的签名重新安装 iPadn 后再试；免费账号或 AltStore 重签无法提供这项能力。": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أعد تثبيت iPadn بتوقيع يتضمن App Group ثم حاول مرة أخرى. الحسابات المجانية وإعادة التوقيع عبر AltStore لا توفّر ذلك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Installiere iPadn mit einer Signatur neu, die App Group enthält, und versuche es erneut. Kostenlose Accounts und AltStore-Neusignaturen bieten das nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reinstall iPadn with a signing profile that includes App Group access, then try again. Free-account and AltStore re-signs cannot provide it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reinstala iPadn con una firma que incluya App Group y vuelve a intentarlo. Las cuentas gratuitas y la refirma con AltStore no lo permiten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réinstallez iPadn avec une signature incluant App Group, puis réessayez. Les comptes gratuits et la re-signature AltStore ne le permettent pas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "App Group 権限を含む署名で iPadn を再インストールしてから再試行してください。無料アカウントや AltStore での再署名では利用できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "App Group 권한이 포함된 서명으로 iPadn을 다시 설치한 뒤 시도하세요. 무료 계정이나 AltStore 재서명으로는 제공할 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reinstale o iPadn com uma assinatura que inclua o App Group e tente novamente. Contas gratuitas e reassinatura pelo AltStore não oferecem isso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переустановите iPadn с подписью, включающей App Group, и повторите попытку. Бесплатные аккаунты и повторная подпись через AltStore этого не дают."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请用包含 App Group 权限的签名重新安装 iPadn 后再试；免费账号或 AltStore 重签无法提供这项能力。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請用包含 App Group 權限的簽名重新安裝 iPadn 後再試；免費帳號或 AltStore 重簽無法提供這項能力。"
          }
        }
      }
    },
    "删除 TestFlight 安装包？": {
      "extractionState": "manual",
