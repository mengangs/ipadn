    "闲置超过 10 分钟，传输已停止。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "闲置超过 10 分钟，传输已停止。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Idle for more than 10 minutes, so sharing stopped."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "閒置超過 10 分鐘，傳輸已停止。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "10分以上操作がなかったため、共有を停止しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "10분 넘게 사용하지 않아 공유가 중지되었습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Простой более 10 минут, передача остановлена."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Más de 10 minutos sin uso; se dejó de compartir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Inactif depuis plus de 10 minutes, le partage s’est arrêté."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Über 10 Minuten inaktiv, die Freigabe wurde beendet."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mais de 10 minutos ocioso; a transferência parou."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خامل لأكثر من 10 دقائق، فتوقفت المشاركة."
          }
        }
      }
    },
    "收到太多错误请求，已停止传输。": {
      "localizations": {
