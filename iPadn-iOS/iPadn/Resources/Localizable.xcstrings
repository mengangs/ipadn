    "验证期间账号已改变，请重新选择下载账号": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The account changed during verification. Choose the download account again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "验证期间账号已改变，请重新选择下载账号"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "驗證期間帳號已改變，請重新選擇下載帳號"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認中にアカウントが変更されました。ダウンロード用アカウントを選び直してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "확인 중에 계정이 변경되었습니다. 다운로드 계정을 다시 선택하십시오."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Во время проверки учетная запись изменилась. Снова выберите учетную запись для загрузки."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cuenta cambió durante la verificación. Vuelve a elegir la cuenta de descarga."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le compte a changé pendant la vérification. Choisissez à nouveau le compte de téléchargement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Account hat sich während der Bestätigung geändert. Wähle den Download-Account erneut."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A conta mudou durante a verificação. Escolha a conta de download novamente."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تغيّر الحساب أثناء التحقق. اختر حساب التنزيل مرة أخرى."
          }
        }
      }
    },
    "验证未完成，请检查网络后重试": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Verification didn't finish. Check the connection and try again."
          }
        },
        "zh-Hans": {
