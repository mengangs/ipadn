    "“%@”没有匹配的应用。试试 App ID、App Store 链接或其他地区。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No apps match “%@”. Try an App ID, an App Store link, or another region."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”没有匹配的应用。试试 App ID、App Store 链接或其他地区。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”沒有匹配的應用。試試 App ID、App Store 連結或其他地區。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」に一致する App がありません。App ID、App Store のリンク、または別の地域でお試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘%@’과(와) 일치하는 앱이 없습니다. App ID, App Store 링크 또는 다른 지역으로 시도하십시오."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет приложений по запросу «%@». Попробуйте App ID, ссылку App Store или другой регион."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguna app coincide con “%@”. Prueba con un App ID, un enlace del App Store u otra región."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune app ne correspond à « %@ ». Essayez un App ID, un lien App Store ou une autre région."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Apps zu „%@“. Versuche eine App-ID, einen App Store-Link oder eine andere Region."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum app corresponde a “%@”. Tente um App ID, um link da App Store ou outra região."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد تطبيقات تطابق «%@». جرّب App ID أو رابط App Store أو منطقة أخرى."
          }
        }
      }
    },
