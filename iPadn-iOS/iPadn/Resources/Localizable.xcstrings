    "任务处理完成后才能删除": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wait for the task to finish processing before deleting"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任务处理完成后才能删除"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "任務處理完成後才能刪除"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タスクの処理が終わるまで待ってから削除してください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업 처리가 끝난 후 삭제하십시오"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дождитесь окончания обработки задачи, прежде чем удалять"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Espera a que termine de procesarse la tarea antes de eliminarla"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Attendez la fin du traitement de la tâche avant de la supprimer"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warte vor dem Löschen, bis die Verarbeitung abgeschlossen ist"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aguarde o fim do processamento da tarefa antes de apagar"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتظر حتى تنتهي معالجة المهمة قبل الحذف"
          }
        }
      }
    },
    "任务文件读取失败；已保留原文件，请先导出诊断再处理。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't read the task list; the original file was kept. Export diagnostics before changing anything."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任务文件读取失败；已保留原文件，请先导出诊断再处理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "任務檔案讀取失敗；已保留原檔案，請先匯出診斷再處理。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タスクリストを読み込めませんでした。元のファイルは保持されています。変更する前に診断情報を書き出してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업 목록을 읽을 수 없습니다. 원본 파일은 유지되었습니다. 변경하기 전에 진단 정보를 내보내십시오."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось прочитать список задач; исходный файл сохранен. Экспортируйте диагностику, прежде чем что-либо менять."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer la lista de tareas; se conservó el archivo original. Exporta el diagnóstico antes de cambiar nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de lire la liste des tâches ; le fichier d’origine a été conservé. Exportez les diagnostics avant toute modification."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Downloadliste konnte nicht gelesen werden; die Originaldatei bleibt erhalten. Exportiere die Diagnose, bevor du etwas änderst."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler a lista de tarefas; o arquivo original foi mantido. Exporte o diagnóstico antes de alterar algo."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّرت قراءة قائمة المهام؛ تم الاحتفاظ بالملف الأصلي. قم بتصدير بيانات التشخيص قبل تغيير أي شيء."
          }
        }
      }
    },
    "任务正在处理，请稍后重试": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The task is still processing. Try again later."
          }
        },
        "zh-Hans": {
