    "这个备份来自更新版本的 iPadn，请先更新 iPadn。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个备份来自更新版本的 iPadn，请先更新 iPadn。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個備份來自較新版本的 iPadn，請先更新 iPadn。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This backup was created by a newer version of iPadn. Update iPadn first."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このバックアップは新しいバージョンの iPadn で作成されました。先に iPadn をアップデートしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 백업은 최신 버전의 iPadn에서 생성되었습니다. 먼저 iPadn을 업데이트하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Sicherung stammt von einer neueren Version von iPadn. Aktualisiere zuerst iPadn."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette sauvegarde provient d’une version plus récente d’iPadn. Mettez d’abord iPadn à jour."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
