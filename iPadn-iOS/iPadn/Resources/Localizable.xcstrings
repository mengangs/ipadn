    "原始 IPA 是处理来源，可能已加密，也可能本来就未加密。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原始 IPA 是处理来源，可能已加密，也可能本来就未加密。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Original IPAs are source files. They may be encrypted or already unencrypted."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "原始 IPA 是處理來源，可能已加密，也可能本來就未加密。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元の IPA は処理の入力です。暗号化されている場合と、元から暗号化されていない場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원본 IPA는 처리의 입력이며 암호화되었거나 원래 암호화되지 않았을 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Исходные IPA служат входными файлами. Они могут быть зашифрованы или изначально не зашифрованы."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los IPA originales son archivos de origen; pueden estar cifrados o no."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les IPA d’origine sont les fichiers sources ; ils peuvent être chiffrés ou non."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Original-IPAs sind Quelldateien und können verschlüsselt oder unverschlüsselt sein."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "IPAs originais são arquivos de origem e podem estar criptografados ou não."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ملفات IPA الأصلية هي ملفات المصدر، وقد تكون مشفّرة أو غير مشفّرة أصلًا."
          }
        }
      }
    },
    "解密会生成独立产物，原始 IPA 保持不变。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "解密会生成独立产物，原始 IPA 保持不变。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Decryption creates a separate output. The original IPA stays unchanged."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "解密會生成獨立產物，原始 IPA 保持不變。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "復号では別の出力を作成し、元の IPA は変更しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복호화는 별도 결과를 생성하며 원본 IPA는 변경하지 않습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Расшифровка создаёт отдельный результат, не изменяя исходный IPA."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se crea un resultado independiente sin modificar el IPA original."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le déchiffrement crée un résultat séparé sans modifier l’IPA d’origine."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Entschlüsselung erstellt eine separate Datei. Das Original bleibt unverändert."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A descriptografia cria um resultado separado. O IPA original não muda."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ينشئ فك التشفير ناتجًا منفصلًا، ويبقى IPA الأصلي دون تغيير."
          }
        }
      }
    },
    "只删除当前产物，原始 IPA 和处理记录保留。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只删除当前产物，原始 IPA 和处理记录保留。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the output will be deleted. The original IPA and processing record are kept."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只刪除當前產物，原始 IPA 和處理記錄保留。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在の出力のみ削除します。元の IPA と記録は保持します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 결과만 삭제합니다. 원본 IPA와 기록은 보존됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удаляется только результат. Исходный IPA и запись сохраняются."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se eliminará el resultado. Se conservan el original y el registro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seul le résultat sera supprimé. L’original et l’historique sont conservés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur das Ergebnis wird gelöscht. Original und Eintrag bleiben erhalten."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas o resultado será excluído. O original e o registro serão mantidos."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيُحذف الناتج فقط. يُحتفظ بالأصل وسجل المعالجة."
