    "NSLocalNetworkUsageDescription": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过本机回环地址加载签名资源和提供安装包文件，并查找本机的安装服务。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loads signing resources and serves installation packages over this device's loopback address, and finds this device's installation service."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスのループバックアドレスで署名リソースを読み込み、インストールパッケージを提供し、このデバイスのインストールサービスを検出します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기의 루프백 주소로 서명 리소스를 불러오고 설치 패키지를 제공하며, 이 기기의 설치 서비스를 찾습니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "透過本機迴環地址載入簽名資源和提供安裝包檔案，並查詢本機的安裝服務。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Загружает ресурсы подписи и раздает установочные пакеты через loopback-адрес этого устройства, а также находит службу установки этого устройства."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Carga recursos de firma y sirve paquetes de instalación mediante la dirección de loopback de este dispositivo, y busca su servicio de instalación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Charge les ressources de signature et fournit les paquets d’installation via l’adresse de bouclage de cet appareil, et détecte son service d’installation."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lädt Signaturressourcen und stellt Installationspakete über die Loopback-Adresse dieses Geräts bereit und findet seinen Installationsdienst."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Carrega recursos de assinatura e fornece pacotes de instalação pelo endereço de loopback deste dispositivo, e encontra o serviço de instalação dele."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحمّل موارد التوقيع ويقدّم حزم التثبيت عبر عنوان loopback لهذا الجهاز، ويعثر على خدمة التثبيت فيه."
          }
        }
      }
    },
