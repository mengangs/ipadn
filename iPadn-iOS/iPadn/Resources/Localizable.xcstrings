          }
        }
      }
    },
    "Apple 账号需要重新登录。请输入当前密码，并根据 Apple 的提示完成验证。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Apple Account needs to sign in again. Enter its current password and follow Apple's prompts."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 账号需要重新登录。请输入当前密码，并根据 Apple 的提示完成验证。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 帳號需要重新登入。請輸入當前密碼，並根據 Apple 的提示完成驗證。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple アカウントで再度サインインが必要です。現在のパスワードを入力し、Apple の案内に従ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 계정에 다시 로그인해야 합니다. 현재 암호를 입력하고 Apple의 안내를 따르십시오."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нужно снова войти в Аккаунт Apple. Введите текущий пароль и следуйте подсказкам Apple."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cuenta de Apple tiene que volver a iniciar sesión. Introduce su contraseña actual y sigue las indicaciones de Apple."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le compte Apple doit se reconnecter. Saisissez son mot de passe actuel et suivez les instructions d’Apple."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Apple Account muss sich erneut anmelden. Gib das aktuelle Passwort ein und folge den Anweisungen von Apple."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Conta Apple precisa iniciar sessão novamente. Digite a senha atual e siga as instruções da Apple."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتاج حساب Apple إلى تسجيل الدخول مرة أخرى. أدخل كلمة السر الحالية واتبع إرشادات Apple."
          }
        }
      }
    },
