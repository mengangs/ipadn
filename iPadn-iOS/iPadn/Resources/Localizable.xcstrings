    "安装包不会离开这台设备": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The package never leaves this device"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安装包不会离开这台设备"
          }
