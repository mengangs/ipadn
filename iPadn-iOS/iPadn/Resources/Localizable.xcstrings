            "value": "此帳號還沒有取得這個應用。先取得一次，之後就能檢視完整版本列表。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアカウントはまだこの App を入手していません。一度入手すると完全なバージョンリストが表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 계정은 아직 이 앱을 받지 않았습니다. 한 번 받으면 전체 버전 목록이 표시됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта учетная запись еще не получала приложение. Получите его один раз, и появится полный список версий."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta cuenta aún no ha obtenido la app. Obtenla una vez y aparecerá la lista completa de versiones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce compte n’a pas encore obtenu l’app. Obtenez-la une fois et la liste complète des versions apparaîtra."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Account hat die App noch nicht geladen. Lade sie einmal, dann erscheint die vollständige Versionsliste."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta conta ainda não obteve o app. Obtenha-o uma vez e a lista completa de versões aparecerá."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يحصل هذا الحساب على التطبيق بعد. احصل عليه مرة واحدة وستظهر قائمة الإصدارات الكاملة."
          }
        }
      }
    },
    "此账号还没有获取这个应用，下面是公开的版本资料。获取后可查看完整列表。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This account hasn't acquired the app, so the public version details are shown. Get it to see the full list."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此账号还没有获取这个应用，下面是公开的版本资料。获取后可查看完整列表。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此帳號還沒有取得這個應用，下面是公開的版本資料。取得後可檢視完整列表。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアカウントはこの App を入手していないため、公開されているバージョン情報を表示しています。入手すると完全なリストが表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 계정이 이 앱을 받지 않아 공개된 버전 정보를 표시합니다. 받으면 전체 목록을 볼 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта учетная запись не получала приложение, поэтому показаны общедоступные сведения о версии. Получите его, чтобы увидеть полный список."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta cuenta no ha obtenido la app, así que se muestran los datos públicos de la versión. Obtenla para ver la lista completa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce compte n’a pas obtenu l’app ; les informations publiques de version sont affichées. Obtenez-la pour voir la liste complète."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Account hat die App nicht geladen, daher werden die öffentlichen Versionsdaten angezeigt. Lade sie, um die vollständige Liste zu sehen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta conta não obteve o app, então os dados públicos da versão são mostrados. Obtenha-o para ver a lista completa."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يحصل هذا الحساب على التطبيق، لذا تُعرض تفاصيل الإصدار العامة. احصل عليه لرؤية القائمة الكاملة."
          }
        }
      }
    },
