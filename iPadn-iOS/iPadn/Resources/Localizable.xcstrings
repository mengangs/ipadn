    "美国、加拿大的标价不含销售税。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prices in the US and Canada exclude sales tax."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "美国、加拿大的标价不含销售税。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "美國、加拿大的標價不含銷售稅。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アメリカとカナダの価格には売上税が含まれていません。"
