          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les téléchargements en cours seront arrêtés et les fichiers temporaires supprimés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
