    "网络请求失败（%lld），请稍后重试": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Network request failed (%lld). Try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网络请求失败（%lld），请稍后重试"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "網路請求失敗（%lld），請稍後重試"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ネットワーク要求に失敗しました（%lld）。もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "네트워크 요청에 실패했습니다(%lld). 다시 시도하십시오."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сетевой запрос не выполнен (%lld). Повторите попытку."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La solicitud de red falló (%lld). Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La requête réseau a échoué (%lld). Réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Netzwerkanfrage fehlgeschlagen (%lld). Versuche es erneut."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A solicitação de rede falhou (%lld). Tente de novo."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فشل طلب الشبكة (%lld). حاول مرة أخرى."
          }
        }
      }
    },
    "网络连接暂时不可用，请检查网络后重试。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The network connection isn't available. Check it and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网络连接暂时不可用，请检查网络后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "網路連線暫時不可用，請檢查網路後重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ネットワークに接続できません。確認してもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "네트워크에 연결할 수 없습니다. 확인하고 다시 시도하십시오."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет подключения к сети. Проверьте его и повторите попытку."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay conexión de red. Revísala e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune connexion réseau. Vérifiez-la et réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Netzwerkverbindung. Prüfe sie und versuche es erneut."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem conexão de rede. Confira e tente de novo."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الاتصال بالشبكة غير متاح. تحقق منه وحاول مرة أخرى."
          }
        }
      }
    },
    "美国、加拿大的标价不含销售税。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prices in the US and Canada exclude sales tax."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "美国、加拿大的标价不含销售税。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "美國、加拿大的標價不含銷售稅。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アメリカとカナダの価格には売上税が含まれていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "미국과 캐나다의 가격에는 판매세가 포함되어 있지 않습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Цены в США и Канаде указаны без налога с продаж."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los precios en EE. UU. y Canadá no incluyen impuestos sobre las ventas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les prix aux États-Unis et au Canada sont hors taxes de vente."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Preise in den USA und Kanada verstehen sich ohne Umsatzsteuer."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os preços nos EUA e no Canadá não incluem impostos sobre vendas."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الأسعار في الولايات المتحدة وكندا لا تشمل ضريبة المبيعات."
          }
        }
      }
    },
