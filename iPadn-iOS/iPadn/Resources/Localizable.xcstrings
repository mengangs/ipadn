    "对比已下载的应用与商店的最新版本，返回有新版本的应用。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对比已下载的应用与商店的最新版本，返回有新版本的应用。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compares downloaded apps with the store’s latest versions and returns the ones with a newer version."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "比較已下載的 App 與商店的最新版本，傳回有新版本的 App。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンロード済みのAppとストアの最新バージョンを比べ、新しいバージョンがあるAppを返します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다운로드한 앱을 스토어의 최신 버전과 비교해 새 버전이 있는 앱을 반환합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сравнивает загруженные приложения с последними версиями в магазине и возвращает те, у которых есть новая версия."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compara las apps descargadas con las últimas versiones de la tienda y devuelve las que tienen una versión nueva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Compare les apps téléchargées aux dernières versions du store et renvoie celles qui ont une nouvelle version."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergleicht geladene Apps mit den neuesten Store-Versionen und gibt die mit neuerer Version zurück."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Compara os apps baixados com as versões mais recentes da loja e retorna os que têm versão nova."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقارن التطبيقات المنزّلة بأحدث إصدارات المتجر ويعيد التطبيقات التي لها إصدار أحدث."
          }
        }
      }
    },
