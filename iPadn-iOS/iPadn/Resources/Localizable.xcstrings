    "日志已脱敏，不含密码、cookie、会话 ID 或代理凭据。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "日志已脱敏，不含密码、cookie、会话 ID 或代理凭据。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Logs are redacted and exclude passwords, cookies, session IDs, and proxy credentials."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "日誌已去識別化，不含密碼、cookie、工作階段 ID 或代理憑證。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログは機密情報を除外済みです（パスワード・Cookie・セッション ID・プロキシ認証情報は含まれません）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그는 민감 정보가 가려져 있으며 비밀번호, 쿠키, 세션 ID, 프록시 자격 증명을 포함하지 않습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Журнал очищен и не содержит паролей, cookie, ID сессий или учётных данных прокси."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los registros están censurados y no incluyen contraseñas, cookies, ID de sesión ni credenciales de proxy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les journaux sont expurgés et n'incluent ni mots de passe, ni cookies, ni ID de session, ni identifiants proxy."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Protokolle sind geschwärzt und enthalten keine Passwörter, Cookies, Sitzungs-IDs oder Proxy-Zugangsdaten."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os registros são anonimizados e não incluem senhas, cookies, IDs de sessão nem credenciais de proxy."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم تنقيح السجلات ولا تحتوي على كلمات مرور أو ملفات تعريف ارتباط أو معرفات جلسة أو بيانات وكيل."
          }
        }
      }
    },
