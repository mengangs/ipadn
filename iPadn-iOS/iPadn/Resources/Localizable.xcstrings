          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Now in system installation. Please wait for completion; this stage cannot be cancelled."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已進入系統安裝階段，請等待完成，期間無法取消。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
