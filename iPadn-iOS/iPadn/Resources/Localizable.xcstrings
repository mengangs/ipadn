    "仅支持下载未加密的 Mac 安装包。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only unencrypted Mac packages can be downloaded."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅支持下载未加密的 Mac 安装包。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅支援下載未加密的 Mac 安裝包。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンロードできるのは暗号化されていない Mac パッケージのみです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "암호화되지 않은 Mac 패키지만 다운로드할 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Можно загружать только незашифрованные пакеты для Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se pueden descargar paquetes para Mac sin cifrar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuls les paquets Mac non chiffrés peuvent être téléchargés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur unverschlüsselte Mac-Pakete können geladen werden."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só é possível baixar pacotes para Mac sem criptografia."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن تنزيل إلا حزم Mac غير المشفّرة."
          }
        }
