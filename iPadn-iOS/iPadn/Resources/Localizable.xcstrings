    "在「设置」中输入这个配对码。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在「设置」中输入这个配对码。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter this code in Settings."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在「設定」中輸入這個配對碼。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このコードを「設定」に入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 코드를 ‘설정’에 입력하십시오."
          }
        },
        "ru": {
