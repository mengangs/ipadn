    "已进入系统安装阶段，无法中断，请等待完成。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已进入系统安装阶段，无法中断，请等待完成。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System installation has started and cannot be interrupted. Please wait for it to finish."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已進入系統安裝階段，無法中斷，請等待完成。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムのインストール段階に入ったため中断できません。完了までお待ちください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 설치 단계에 진입하여 중단할 수 없습니다. 완료될 때까지 기다려 주세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Началась системная установка. Прервать её нельзя — дождитесь завершения."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La instalación del sistema ya ha comenzado y no se puede interrumpir. Espera a que termine."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'installation système a commencé et ne peut pas être interrompue. Veuillez patienter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Systeminstallation hat begonnen und kann nicht unterbrochen werden. Bitte warten Sie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A instalação do sistema já começou e não pode ser interrompida. Aguarde a conclusão."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بدأت مرحلة تثبيت النظام ولا يمكن مقاطعتها. يرجى الانتظار حتى تكتمل."
          }
        }
      }
    },
    "已进入系统安装阶段，请等待完成，期间无法取消。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
