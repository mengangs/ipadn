        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha um número confiável"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر رقم هاتف موثوقًا"
          }
        }
      }
    },
    "Apple 将向所选号码为 %@ 发送 6 位短信验证码。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 将向所选号码为 %@ 发送 6 位短信验证码。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple will send a 6-digit SMS verification code for %@ to the selected number."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 將向所選號碼為 %@ 傳送 6 位數簡訊驗證碼。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple は選択した番号に %@ 用の 6 桁の SMS 確認コードを送信します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple이 선택한 번호로 %@의 6자리 SMS 인증 코드를 보냅니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple отправит 6-значный SMS-код для %@ на выбранный номер."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple enviará un código SMS de 6 dígitos para %@ al número seleccionado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple enverra un code SMS à 6 chiffres pour %@ au numéro sélectionné."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple sendet einen 6-stelligen SMS-Code für %@ an die gewählte Nummer."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Apple enviará um código SMS de 6 dígitos para %@ no número selecionado."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سترسل Apple رمز تحقق SMS مكوّنًا من 6 أرقام لحساب %@ إلى الرقم المحدد."
          }
        }
      }
    },
    "短信验证": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "短信验证"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SMS Verification"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "簡訊驗證"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SMS 認証"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SMS 인증"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "SMS-проверка"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Verificación por SMS"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérification par SMS"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "SMS-Bestätigung"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verificação por SMS"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التحقق عبر SMS"
          }
        }
      }
    },
    "该 Apple 账号当前处于安全锁定状态，请先前往 account.apple.com 解锁后再试。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该 Apple 账号当前处于安全锁定状态，请先前往 account.apple.com 解锁后再试。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Apple Account is currently locked for security reasons. Unlock it at account.apple.com and try again."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Apple 帳號目前處於安全鎖定狀態，請先前往 account.apple.com 解鎖後再試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Apple Account はセキュリティ上の理由でロックされています。account.apple.com でロックを解除してからやり直してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Apple 계정은 보안상의 이유로 잠겨 있습니다. account.apple.com에서 잠금을 해제한 후 다시 시도하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот аккаунт Apple заблокирован по соображениям безопасности. Разблокируйте его на account.apple.com и повторите попытку."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta cuenta de Apple está bloqueada por motivos de seguridad. Desbloquéala en account.apple.com e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce compte Apple est verrouillé pour des raisons de sécurité. Déverrouillez-le sur account.apple.com puis réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Apple Account ist aus Sicherheitsgründen gesperrt. Entsperre ihn unter account.apple.com und versuche es erneut."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta Conta Apple está bloqueada por motivos de segurança. Desbloqueie em account.apple.com e tente novamente."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حساب Apple هذا مقفل حاليًا لأسباب أمنية. افتح قفله عبر account.apple.com ثم حاول مجددًا."
          }
        }
      }
    },
    "Apple 已暂时限制该账号的验证码请求，通常是短时间内尝试次数过多所致。请暂停重试并等待一段时间后再试，也可前往 account.apple.com 检查账号状态。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 已暂时限制该账号的验证码请求，通常是短时间内尝试次数过多所致。请暂停重试并等待一段时间后再试，也可前往 account.apple.com 检查账号状态。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple has temporarily limited verification code requests for this account, usually due to too many attempts in a short time. Pause retrying and wait before trying again, or check account status at account.apple.com."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 已暫時限制此帳號的驗證碼請求，通常是短時間內嘗試次數過多所致。請暫停重試並等待一段時間後再試，也可前往 account.apple.com 檢查帳號狀態。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "短時間に確認コードの要求が集中したため、Apple がこのアカウントの認証を一時的に制限しています。連続再試行を控えてしばらく待ってから再試行するか、account.apple.com で状態を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "짧은 시간에 너무 많이 시도하여 Apple이 이 계정의 인증 코드 요청을 일시적으로 제한했습니다. 잠시 기다린 후 다시 시도하거나 account.apple.com에서 계정 상태를 확인하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple временно ограничила запросы кодов проверки для этого аккаунта, обычно из-за слишком частых попыток. Подождите некоторое время перед повторной попыткой или проверьте статус аккаунта на account.apple.com."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple limitó temporalmente las solicitudes de códigos de verificación de esta cuenta, normalmente por demasiados intentos seguidos. Espera un tiempo antes de reintentar o revisa el estado en account.apple.com."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple a temporairement limité les demandes de code de validation pour ce compte, généralement après trop de tentatives rapprochées. Patientez avant de réessayer ou vérifiez l'état sur account.apple.com."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple hat Bestätigungscode-Anfragen für diesen Account vorübergehend eingeschränkt, meist wegen zu vieler Versuche in kurzer Zeit. Warte bitte etwas ab oder prüfe den Status unter account.apple.com."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Apple limitou temporariamente as solicitações de código de verificação desta conta, geralmente por muitas tentativas seguidas. Aguarde antes de tentar novamente ou verifique o status em account.apple.com."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قيّدت Apple مؤقتًا طلبات رمز التحقق لهذا الحساب، عادةً بسبب كثرة المحاولات خلال وقت قصير. توقف عن إعادة المحاولة وانتظر قليلًا، أو تحقق من حالة الحساب عبر account.apple.com."
          }
        }
      }
    },
    "验证码未通过 Apple 验证（可能输入有误、已过期或填入了旧短信验证码）。请重试并等待最新验证码送达后再输入。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "验证码未通过 Apple 验证（可能输入有误、已过期或填入了旧短信验证码）。请重试并等待最新验证码送达后再输入。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple rejected the verification code (it may be incorrect, expired, or from an older SMS). Retry and wait for the latest code to arrive before entering it."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "驗證碼未通過 Apple 驗證（可能輸入有誤、已過期或填入了舊簡訊驗證碼）。請重試並等待最新驗證碼送達後再輸入。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認コードが Apple に承認されませんでした（入力ミス、有効期限切れ、または古い SMS コードの可能性があります）。再試行し、最新のコードが届いてから入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple이 인증 코드를 확인하지 못했습니다(오입력, 만료 또는 이전 SMS 코드일 수 있습니다). 다시 시도하고 최신 코드가 도착한 후 입력하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple не приняла код проверки (возможно, он неверен, истёк или взят из старого SMS). Повторите попытку и дождитесь нового кода."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple no aceptó el código de verificación (puede ser incorrecto, haber caducado o ser de un SMS anterior). Reintenta y espera el código más reciente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple n'a pas validé le code (il est peut-être incorrect, expiré ou issu d'un ancien SMS). Réessayez et attendez le nouveau code."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple hat den Bestätigungscode abgelehnt (möglicherweise falsch, abgelaufen oder aus einer älteren SMS). Versuche es erneut und warte auf den neuesten Code."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Apple rejeitou o código de verificação (pode estar incorreto, expirado ou ser de um SMS anterior). Tente novamente e aguarde o código mais recente."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رفضت Apple رمز التحقق (قد يكون غير صحيح أو منتهي الصلاحية أو من رسالة SMS سابقة). أعد المحاولة وانتظر وصول أحدث رمز قبل إدخاله."
          }
        }
      }
    },
    "该 Apple 账号没有可用于短信验证的受信任手机号，请先前往 account.apple.com 添加受信任电话号码后重试。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该 Apple 账号没有可用于短信验证的受信任手机号，请先前往 account.apple.com 添加受信任电话号码后重试。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Apple Account has no trusted phone number available for SMS verification. Add a trusted phone number at account.apple.com and try again."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Apple 帳號沒有可用於簡訊驗證的受信任手機號碼，請先前往 account.apple.com 新增受信任電話號碼後重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Apple Account には SMS 認証に使える信頼できる電話番号が登録されていません。account.apple.com で追加してから再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Apple 계정에 SMS 인증에 사용할 수 있는 신뢰할 수 있는 전화번호가 없습니다. account.apple.com에서 번호를 추가한 후 다시 시도하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У этого аккаунта Apple нет доверенного номера для SMS-проверки. Добавьте номер на account.apple.com и повторите попытку."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta cuenta de Apple no tiene un número de teléfono de confianza disponible para SMS. Agrega uno en account.apple.com e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce compte Apple ne dispose d'aucun numéro de confiance pour la vérification par SMS. Ajoutez-en un sur account.apple.com puis réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Apple Account hat keine vertrauenswürdige Telefonnummer für SMS-Bestätigung. Füge unter account.apple.com eine Nummer hinzu und versuche es erneut."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta Conta Apple não tem um número confiável disponível para SMS. Adicione um número em account.apple.com e tente novamente."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يحتوي حساب Apple هذا على رقم هاتف موثوق متاح للتحقق عبر SMS. أضف رقم هاتف موثوقًا عبر account.apple.com ثم أعد المحاولة."
          }
        }
      }
    },
    "Apple 要求重新验证本次登录，请重试；若反复出现请稍等片刻再试。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 要求重新验证本次登录，请重试；若反复出现请稍等片刻再试。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple requested verification again for this sign-in. Please try again, or wait a moment if it repeats."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 要求重新驗證本次登入，請重試；若反覆出現請稍等片刻再試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple が再度確認を要求しました。再試行してください。繰り返す場合は少し時間を置いてからお試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple이 이번 로그인에 대해 다시 인증을 요청했습니다. 다시 시도하거나 반복되면 잠시 후 시도해 주세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple повторно запросила проверку для этого входа. Повторите попытку или подождите немного, если ошибка повторяется."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple solicitó verificar este inicio de sesión nuevamente. Inténtalo de nuevo o espera un momento si se repite."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple a demandé une nouvelle validation pour cette connexion. Réessayez ou patientez un instant si cela se répète."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple hat erneut eine Bestätigung für diese Anmeldung angefordert. Bitte versuche es noch einmal oder warte kurz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Apple solicitou uma nova verificação para este início de sessão. Tente novamente ou aguarde um momento se repetir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "طلبت Apple التحقق مجددًا لتسجيل الدخول هذا. يرجى المحاولة مرة أخرى أو الانتظار قليلًا إذا تكرر الأمر."
          }
        }
      }
    },
    "Apple 需要您先在系统 App Store 中完成账号确认（如同意条款、完善付款信息或首次启用检查）。请先用该账号在系统 App Store 点击一次「获取」任意免费应用，完成后再回 iPadn 下载。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 需要您先在系统 App Store 中完成账号确认（如同意条款、完善付款信息或首次启用检查）。请先用该账号在系统 App Store 点击一次「获取」任意免费应用，完成后再回 iPadn 下载。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple requires you to complete account setup in the system App Store (such as accepting terms, updating billing info, or first-time store review). Tap Get on any free app in the system App Store with this account, then return to iPadn to download."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 需要您先在系統 App Store 中完成帳號確認（如同意條款、完善付款資訊或首次啟用檢查）。請先用該帳號在系統 App Store 點選一次「取得」任意免費 App，完成後再回 iPadn 下載。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム標準の App Store でアカウントの確認（規約への同意、お支払い情報の更新、初回利用の確認など）が必要です。このアカウントで App Store の無料アプリを一度「入手」してから、iPadn に戻ってダウンロードしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 App Store에서 계정 확인(약관 동의, 결제 정보 업데이트 또는 최초 사용 확인 등)이 필요합니다. 이 계정으로 시스템 App Store에서 무료 앱을 한 번 '받기'한 뒤 iPadn으로 돌아와 다운로드하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple требует завершить проверку аккаунта в системном App Store (принять условия, обновить платёжные данные или пройти первичную проверку). Нажмите «Загрузить» для любого бесплатного приложения в App Store этим аккаунтом, затем вернитесь в iPadn."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple requiere completar la verificación de la cuenta en el App Store del sistema (aceptar términos, actualizar facturación o revisión inicial). Toca Obtener en cualquier app gratuita en el App Store con esta cuenta y luego vuelve a iPadn para descargar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple exige de terminer la vérification du compte dans l'App Store du système (conditions générales, facturation ou première utilisation). Touchez Obtenir sur une app gratuite dans l'App Store avec ce compte, puis revenez dans iPadn."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple erfordert eine Kontobestätigung im System-App Store (Bedingungen akzeptieren, Zahlungsdaten aktualisieren oder Erstprüfung). Tippe mit diesem Account im App Store einmal auf „Laden“ bei einer kostenlosen App und kehre dann zu iPadn zurück."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Apple exige concluir a verificação da conta na App Store do sistema (aceitar termos, atualizar cobrança ou revisão inicial). Toque em Obter em qualquer app gratuito na App Store com esta conta e volte ao iPadn para baixar."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتطلب Apple إكمال تأكيد الحساب في App Store النظام (مثل الموافقة على الشروط أو تحديث بيانات الدفع أو المراجعة الأولى). اضغط «تنزيل» لأي تطبيق مجاني في App Store بهذا الحساب، ثم عد إلى iPadn للتنزيل."
          }
        }
      }
    },
    "原生安装需要 iOS 17.4 及以上系统。当前系统请改用「一键安装」或「本机证书」。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原生安装需要 iOS 17.4 及以上系统。当前系统请改用「一键安装」或「本机证书」。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "原生安裝需要 iOS 17.4 及以上系統。目前系統請改用「一鍵安裝」或「本機憑證」。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Native Install requires iOS 17.4 or later. Please use One-Tap Install or Local Certificate on this system."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ネイティブインストールには iOS 17.4 以降が必要です。現在のシステムでは「ワンタップインストール」または「ローカル証明書」をご利用ください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "네이티브 설치에는 iOS 17.4 이상이 필요합니다. 현재 시스템에서는 '원탭 설치' 또는 '로컬 인증서'를 사용해 주세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нативная установка требует iOS 17.4 или новее. На этой системе используйте «Быстрая установка» или «Локальный сертификат»."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La instalación nativa requiere iOS 17.4 o posterior. Usa «Instalación en un toque» o «Certificado local» en este sistema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’installation native nécessite iOS 17.4 ou version ultérieure. Utilisez « Installation en un geste » ou « Certificat local » sur ce système."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die native Installation erfordert iOS 17.4 oder neuer. Verwende auf diesem System bitte „Ein-Tipp-Installation“ oder „Lokales Zertifikat“."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A instalação nativa requer iOS 17.4 ou posterior. Use «Instalação com um toque» ou «Certificado local» neste sistema."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتطلب التثبيت الأصلي نظام iOS 17.4 أو أحدث. يُرجى استخدام «التثبيت بنقرة واحدة» أو «الشهادة المحلية» على هذا النظام."
          }
        }
      }
    },
    "原生安装需要 iOS 17.4 及以上系统": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原生安装需要 iOS 17.4 及以上系统"
          }
        },
