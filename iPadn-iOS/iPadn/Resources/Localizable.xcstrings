    "仅清除本账号保存的 TestFlight 会话，不会退出 iPadn 商店账号。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅清除本账号保存的 TestFlight 会话，不会退出 iPadn 商店账号。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only clears the saved TestFlight session for this account without signing out of your iPadn Store account."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅清除本帳號儲存的 TestFlight 工作階段，不會登出 iPadn 商店帳號。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアカウントの TestFlight セッションのみを削除します。iPadn のストアアカウントからはサインアウトされません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 계정에 저장된 TestFlight 세션만 지우며 iPadn 스토어 계정은 로그아웃되지 않습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удаляет только сохранённую сессию TestFlight для этого аккаунта; выход из аккаунта магазина iPadn не выполняется."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo borra la sesión de TestFlight guardada para esta cuenta sin cerrar sesión en tu cuenta de la tienda de iPadn."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Efface uniquement la session TestFlight enregistrée pour ce compte sans vous déconnecter du compte Store iPadn."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löscht nur die gespeicherte TestFlight-Sitzung dieses Accounts, ohne deinen iPadn-Store-Account abzumelden."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Limpa apenas a sessão salva do TestFlight desta conta sem sair da conta da loja no iPadn."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمسح جلسة TestFlight المحفوظة لهذا الحساب فقط دون تسجيل الخروج من حساب متجر iPadn."
          }
        }
      }
    },
    "下次使用此账号访问 TestFlight 时需要重新验证；已下载的安装包会保留。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下次使用此账号访问 TestFlight 时需要重新验证；已下载的安装包会保留。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You will need to verify again next time you use TestFlight with this account. Downloaded packages are kept."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "下次使用此帳號造訪 TestFlight 時需要重新驗證；已下載的安裝包會保留。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次回このアカウントで TestFlight を使う際に再認証が必要です。ダウンロード済みのパッケージは保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음에 이 계정으로 TestFlight를 사용할 때 다시 인증해야 합니다. 다운로드된 패키지는 유지됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При следующем использовании TestFlight с этим аккаунтом потребуется повторная проверка. Скачанные пакеты сохранятся."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendrás que verificar de nuevo la próxima vez que uses TestFlight con esta cuenta. Los paquetes descargados se conservarán."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une nouvelle vérification sera requise la prochaine fois avec ce compte. Les paquets téléchargés sont conservés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim nächsten Zugriff auf TestFlight mit diesem Account ist eine erneute Bestätigung erforderlich. Geladene Pakete bleiben erhalten."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você precisará verificar novamente da próxima vez que usar o TestFlight com esta conta. Os pacotes baixados serão mantidos."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستحتاج إلى إعادة التحقق في المرة القادمة التي تستخدم فيها TestFlight بهذا الحساب؛ وسيتم الاحتفاظ بالحزم المحمّلة."
          }
        }
      }
    },
    "已复用 iPadn 账号密码，首次使用仅需双重认证": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已复用 iPadn 账号密码，首次使用仅需双重认证"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reusing your iPadn credentials — only two-factor verification is needed the first time"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已重複使用 iPadn 帳號密碼，首次使用僅需雙重認證"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPadn のアカウント情報を再利用します。初回は 2 ファクタ認証のみ必要です"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPadn 계정 정보를 재사용합니다. 최초 사용 시 이중 인증만 필요합니다"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используются данные аккаунта iPadn — при первом входе нужна только двухфакторная проверка"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa tus credenciales de iPadn; la primera vez solo se requiere verificación en dos pasos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réutilise vos identifiants iPadn ; seule la validation à deux facteurs est requise la première fois"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutzt deine iPadn-Zugangsdaten – beim ersten Mal ist nur die Zwei-Faktor-Bestätigung nötig"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reutiliza suas credenciais do iPadn; na primeira vez é necessária apenas a autenticação de dois fatores"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُستخدم بيانات حساب iPadn نفسها؛ يلزم التحقق بخطوتين في المرة الأولى فقط"
          }
        }
      }
    },
    "验证并连接 TestFlight": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "验证并连接 TestFlight"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Verify & Connect TestFlight"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "驗證並連接 TestFlight"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "認証して TestFlight に接続"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인증 후 TestFlight 연결"
          }
        },
        "ru": {
          "stringUnit": {
