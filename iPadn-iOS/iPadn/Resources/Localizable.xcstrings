    "\n\n…（仅显示前 %lld 个字符，完整内容请提取后查看）": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n…(showing the first %lld characters; extract the file to see the rest)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n…（仅显示前 %lld 个字符，完整内容请提取后查看）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n…（僅顯示前 %lld 個字元，完整內容請提取後檢視）"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n…（最初の %lld 文字を表示しています。残りはファイルを取り出して確認してください）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n…(처음 %lld자를 표시하고 있습니다. 나머지는 파일을 추출하여 확인하십시오)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n…(показаны первые %lld символов; извлеките файл, чтобы увидеть остальное)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n…(se muestran los primeros %lld caracteres; extrae el archivo para ver el resto)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n…(affichage des %lld premiers caractères ; extrayez le fichier pour voir la suite)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n…(die ersten %lld Zeichen werden angezeigt; extrahiere die Datei, um den Rest zu sehen)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n…(mostrando os primeiros %lld caracteres; extraia o arquivo para ver o restante)"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n…(يتم عرض أول %lld حرف؛ استخرج الملف لرؤية الباقي)"
          }
        }
      }
    },
