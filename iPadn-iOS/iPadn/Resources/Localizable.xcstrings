    "可以在下载任务详情中浏览安装包内容、查看账号令牌和设备标识，并在「应用包」页对 IPA 发起 FairPlay 解密与导出。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可以在下载任务详情中浏览安装包内容、查看账号令牌和设备标识，并在「应用包」页对 IPA 发起 FairPlay 解密与导出。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Browse package contents, inspect account tokens and device IDs in task details, and decrypt or export IPAs via FairPlay in the Packages tab."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可以在下載任務詳情中瀏覽安裝包內容、檢視帳號權杖和裝置識別碼，並在「應用包」頁對 IPA 發起 FairPlay 解密與匯出。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タスク詳細でパッケージ内容の閲覧やアカウントトークン・デバイスIDの確認ができ、「パッケージ」タブからIPAのFairPlay復号・書き出しを行えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업 상세에서 패키지 내용 탐색과 계정 토큰·기기 ID 확인이 가능하며, '패키지' 탭에서 IPA의 FairPlay 복호화 및 내보내기를 실행할 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Просматривайте содержимое пакетов, токены аккаунтов и ID устройств в деталях задачи, а также расшифровывайте и экспортируйте IPA через FairPlay на вкладке «Пакеты»."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Explora el contenido de paquetes, consulta tokens de cuenta e IDs de dispositivo en los detalles de tarea y descifra o exporta IPAs con FairPlay en la pestaña Paquetes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parcourez le contenu des paquets, consultez les jetons et identifiants d'appareil dans les détails des tâches et déchiffrez ou exportez des IPA via FairPlay dans l'onglet Paquets."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Durchsuchen Sie Paket-Inhalte, prüfen Sie Kontotoken und Geräte-IDs in den Aufgabendetails und entschlüsseln oder exportieren Sie IPAs per FairPlay im Tab „Pakete“."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Explore o conteúdo dos pacotes, consulte tokens da conta e IDs do dispositivo nos detalhes da tarefa e descriptografe ou exporte IPAs via FairPlay na aba Pacotes."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تصفّح محتويات الحزم، واطّلع على رموز الحساب ومعرّفات الجهاز في تفاصيل المهمة، وقم بفك تشفير ملفات IPA وتصديرها عبر FairPlay في تبويب «الحزم»."
          }
        }
      }
    },
    "打开后可以浏览安装包内容、查看账号令牌、修改设备标识，并启用「应用包」解密功能。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开后可以浏览安装包内容、查看账号令牌、修改设备标识，并启用「应用包」解密功能。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable to browse package contents, inspect account tokens, edit device IDs, and unlock FairPlay decryption in Packages."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟後可以瀏覽安裝包內容、檢視帳號權杖、修改裝置識別碼，並啟用「應用包」解密功能。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンにするとパッケージ内容の閲覧、アカウントトークンの確認、デバイスIDの編集、「パッケージ」の復号機能が有効になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "켜면 패키지 내용 탐색, 계정 토큰 확인, 기기 ID 수정 및 '패키지' 복호화 기능을 사용할 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите, чтобы просматривать содержимое пакетов, токены аккаунтов, менять ID устройства и открыть расшифровку в разделе «Пакеты»."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actívalo para explorar contenido de paquetes, consultar tokens de cuenta, editar el ID del dispositivo y habilitar el descifrado en Paquetes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez cette option pour parcourir le contenu des paquets, consulter les jetons, modifier l'identifiant d'appareil et débloquer le déchiffrement dans Paquets."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivieren, um Paket-Inhalte zu durchsuchen, Kontotoken anzuzeigen, Geräte-IDs zu bearbeiten und die Entschlüsselung unter „Pakete“ freizuschalten."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative para explorar conteúdo dos pacotes, consultar tokens da conta, editar o ID do dispositivo e ativar a descriptografia em Pacotes."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فعّل هذا الخيار لتصفح محتوى الحزم ومعاينة رموز الحساب وتعديل معرّف الجهاز وتفعيل فك التشفير في «الحزم»."
          }
        }
      }
    },
