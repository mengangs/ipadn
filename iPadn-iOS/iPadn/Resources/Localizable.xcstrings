    "App ID": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "App ID"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "App ID"
          }
        }
      }
    },
    "App ID %@，点按复制": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "App ID %@, tap to copy"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "App ID %@，点按复制"
          }
        }
      }
    },
    "App ID 只能包含数字": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The App ID can only contain digits"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "App ID 只能包含数字"
          }
        }
      }
    },
    "App ID 必须是数字": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The App ID must be digits"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "App ID 必须是数字"
          }
        }
      }
    },
    "App Store 每个地区最多列出 10 个热门内购项目。同名项目按价格分档，通常对应月度、年度等不同订阅。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each App Store storefront lists up to 10 popular in-app purchases. Purchases with the same name are grouped by price, usually monthly, yearly and other terms."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store 每个地区最多列出 10 个热门内购项目。同名项目按价格分档，通常对应月度、年度等不同订阅。"
          }
        }
      }
    },
    "App Store 没有列出这个应用的内购项目。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The App Store doesn't list any in-app purchases for this app."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store 没有列出这个应用的内购项目。"
          }
        }
      }
    },
    "App Store 链接中没有有效 App ID": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The App Store link has no valid App ID"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store 链接中没有有效 App ID"
          }
        }
      }
    },
    "Apple 暂时无法完成登录，请稍后重试。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple couldn't complete sign-in. Try again later."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 暂时无法完成登录，请稍后重试。"
          }
        }
      }
    },
    "Apple 暂时无法完成该操作，请稍后重试。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple couldn't complete the operation. Try again later."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 暂时无法完成该操作，请稍后重试。"
          }
        }
      }
    },
    "Apple 服务暂时不可用，请稍后再试。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple's service is unavailable. Try again later."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 服务暂时不可用，请稍后再试。"
          }
        }
      }
    },
    "Apple 未接受本次验证。请检查账号密码，并输入最新的 6 位验证码后重试。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple didn't accept this verification. Check the account password and enter the latest 6-digit code."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 未接受本次验证。请检查账号密码，并输入最新的 6 位验证码后重试。"
          }
        }
      }
    },
    "Apple 未返回完整登录信息，请重试": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple didn't return complete sign-in details. Try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 未返回完整登录信息，请重试"
          }
        }
      }
    },
    "Apple 未返回有效的登录数据，请稍后重试或切换网络。仍然失败可在设置中导出诊断信息。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple didn't return valid sign-in data. Try again later or switch networks. If it keeps failing, export diagnostics in Settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 未返回有效的登录数据，请稍后重试或切换网络。仍然失败可在设置中导出诊断信息。"
          }
        }
      }
    },
    "Apple 未返回登录信息，请检查账号后重试。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple didn't return sign-in details. Check the account and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 未返回登录信息，请检查账号后重试。"
          }
        }
      }
    },
    "Apple 没有返回该版本的下载信息": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple didn't return download details for this version"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 没有返回该版本的下载信息"
          }
        }
      }
    },
    "Apple 没有返回该版本的信息": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple didn't return details for this version"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 没有返回该版本的信息"
          }
        }
      }
    },
    "Apple 版本服务暂时未返回，已为你显示公开版本列表。可稍后点击刷新重试。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple's version service didn't respond, so the public version list is shown. Tap refresh to try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 版本服务暂时未返回，已为你显示公开版本列表。可稍后点击刷新重试。"
          }
        }
      }
    },
    "Apple 用设备标识识别正在下载的设备。修改后，已登录的账号可能需要重新登录；Apple 也会限制一个账号同时使用的设备数量。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple identifies the device that downloads with this identifier. After changing it, signed-in accounts may need to sign in again, and Apple limits how many devices one account can use at a time."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 用设备标识识别正在下载的设备。修改后，已登录的账号可能需要重新登录；Apple 也会限制一个账号同时使用的设备数量。"
          }
        }
      }
    },
    "Apple 登录地址无效": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple's sign-in URL is invalid"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 登录地址无效"
          }
        }
      }
    },
    "Apple 登录已过期，请重新登录。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple sign-in expired. Sign in again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 登录已过期，请重新登录。"
          }
        }
      }
    },
    "Apple 登录暂时不可用，请稍后重试": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple sign-in is unavailable. Try again later."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 登录暂时不可用，请稍后重试"
          }
        }
      }
    },
    "Apple 登录配置中没有可用的登录地址，请稍后重试。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple's sign-in configuration has no usable URL. Try again later."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 登录配置中没有可用的登录地址，请稍后重试。"
          }
