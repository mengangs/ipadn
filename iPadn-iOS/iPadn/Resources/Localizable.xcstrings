    "此应用属于 Apple Arcade，需要此账号订阅 Apple Arcade 后才能下载。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This app is part of Apple Arcade. The account needs an Apple Arcade subscription to download it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此应用属于 Apple Arcade，需要此账号订阅 Apple Arcade 后才能下载。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此應用屬於 Apple Arcade，需要此帳號訂閱 Apple Arcade 後才能下載。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この App は Apple Arcade のタイトルです。ダウンロードするにはアカウントで Apple Arcade に登録している必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 앱은 Apple Arcade에 포함되어 있습니다. 다운로드하려면 계정이 Apple Arcade를 구독해야 합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это приложение входит в Apple Arcade. Для загрузки учетной записи нужна подписка Apple Arcade."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta app forma parte de Apple Arcade. La cuenta necesita una suscripción a Apple Arcade para descargarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette app fait partie d’Apple Arcade. Le compte doit être abonné à Apple Arcade pour la télécharger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese App gehört zu Apple Arcade. Der Account braucht ein Apple Arcade-Abo, um sie zu laden."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este app faz parte do Apple Arcade. A conta precisa de uma assinatura do Apple Arcade para baixá-lo."
