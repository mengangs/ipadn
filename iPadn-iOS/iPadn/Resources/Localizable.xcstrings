          }
        }
      }
    },
    "点按切换下载账号，点按带「重新登录」标记的账号可补全登录凭据，侧滑可移除。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按切换下载账号，点按带「重新登录」标记的账号可补全登录凭据，侧滑可移除。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap an account to switch, tap one marked Sign in again to restore credentials, or swipe left to remove."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點按切換下載帳號，點按標記「重新登入」的帳號可補全登入憑證，向左滑動可移除。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タップしてアカウントを切り替え、「再サインイン」のアカウントをタップして資格情報を復元します。左スワイプで削除できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "탭하여 다운로드 계정을 전환하고, 다시 로그인으로 표시된 계정을 탭해 자격 증명을 복원하세요. 밀어서 삭제할 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите на аккаунт для переключения или на аккаунт с пометкой повторного входа для восстановления доступа; смахните влево для удаления."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca una cuenta para cambiarla, toca una marcada para volver a iniciar sesión o desliza para eliminarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez un compte pour en changer, touchez celui à reconnecter pour restaurer la session, ou balayez pour supprimer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippen zum Wechseln, bei Markierung zur erneuten Anmeldung tippen oder wischen zum Entfernen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque para alternar de conta, toque em uma marcada para entrar novamente ou deslize para remover."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط للتبديل، أو اضغط على الحساب المعلّم لإعادة تسجيل الدخول، أو اسحب للإزالة."
          }
        }
      }
    },
