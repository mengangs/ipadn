          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購入履歴を同期し、ライセンスを持つ App をダウンロードします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구입 내역을 동기화하고 라이선스가 있는 앱을 다운로드합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
