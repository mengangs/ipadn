          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このバージョンではこの Mac パッケージをダウンロードできません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 버전에서는 이 Mac 패키지를 다운로드할 수 없습니다"
          }
