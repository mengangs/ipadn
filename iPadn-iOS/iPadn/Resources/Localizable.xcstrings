    "已关注，有新版本、降价或下架时会提醒你": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Following. You'll be notified about new versions, price drops or removal."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已关注，有新版本、降价或下架时会提醒你"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已關注，有新版本、降價或下架時會提醒你"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォローしました。新しいバージョン、値下げ、販売終了を通知します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "팔로우했습니다. 새 버전, 가격 인하 또는 판매 중지를 알려 드립니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы отслеживаете приложение. Вы получите уведомление о новых версиях, снижении цены или удалении."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Siguiendo. Recibirás avisos de nuevas versiones, bajadas de precio o retiradas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suivie. Vous serez averti des nouvelles versions, baisses de prix ou retraits."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du folgst der App. Du wirst über neue Versionen, Preissenkungen oder Entfernung informiert."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seguindo. Você será avisado sobre novas versões, quedas de preço ou remoção."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتم المتابعة. سيتم إعلامك بالإصدارات الجديدة أو انخفاض السعر أو الإزالة."
          }
        }
      }
    },
