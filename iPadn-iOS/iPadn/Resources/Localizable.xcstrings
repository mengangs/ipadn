    "当前地区未查到商店资料": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No store listing found in this region"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前地區未查到商店資料"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この地域のストア情報が見つかりません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 지역에서 스토어 정보를 찾지 못함"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложение не найдено в магазине этого региона"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
