          "stringUnit": {
            "state": "translated",
            "value": "已下載的安裝包也會一併刪除。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンロード済みのパッケージも削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다운로드한 패키지도 삭제됩니다."
