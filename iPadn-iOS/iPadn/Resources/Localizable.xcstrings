{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": ""
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": ""
          }
        }
      }
    },
    "\n\n…（仅显示前 %lld 个字符，完整内容请提取后查看）": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n…(showing the first %lld characters; extract the file to see the rest)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n…（仅显示前 %lld 个字符，完整内容请提取后查看）"
          }
        }
      }
    },
    " · %lld 个可更新": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": " · %lld update"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": " · %lld updates"
                }
              }
            }
          }
        },
        "zh-Hans": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": " · %lld 个可更新"
                }
              }
            }
          }
        }
      }
    },
    " 等": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " and more"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": " 等"
          }
        }
      }
    },
    "%@\n已下载的安装包会保留。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\nDownloaded packages are kept."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n已下载的安装包会保留。"
          }
        }
      }
    },
    "%@\n这是当前下载账号，移除后将退出登录。\n已下载的安装包会保留。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\nThis is the current download account. Removing it signs you out.\nDownloaded packages are kept."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n这是当前下载账号，移除后将退出登录。\n已下载的安装包会保留。"
          }
        }
      }
    },
    "%@ %@ 或更高版本": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ or later"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ 或更高版本"
          }
        }
      }
    },
    "%@ · %lld": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · %lld"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · %lld"
          }
        }
      }
    },
    "%@ 有新版本": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ has an update"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 有新版本"
          }
        }
      }
    },
    "%@。打开 iPadn 下载新版本。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Open iPadn to download the new version."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@。打开 iPadn 下载新版本。"
          }
        }
      }
    },
    "%@（%@）：%@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (%@): %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@（%@）：%@"
          }
        }
      }
    },
    "%@，可以撤销": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Undo is available."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@，可以撤销"
          }
        }
