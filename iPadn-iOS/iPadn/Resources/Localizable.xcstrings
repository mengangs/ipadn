            "value": "Safari에서 설치를 확인한 후 iPadn으로 돌아와 기다리십시오."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подтвердите установку в Safari, затем вернитесь в iPadn и подождите."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirma la instalación en Safari y luego vuelve a iPadn y espera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirmez l’installation dans Safari, puis revenez dans iPadn et patientez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestätige die Installation in Safari, kehre dann zu iPadn zurück und warte."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirme a instalação no Safari, depois volte ao iPadn e aguarde."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أكّد التثبيت في Safari، ثم عُد إلى iPadn وانتظر."
          }
        }
      }
    },
    "请在「设置」中安装描述文件，然后在「通用 › 关于本机 › 证书信任设置」中开启信任。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install the profile in Settings, then enable trust under General › About › Certificate Trust Settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在「设置」中安装描述文件，然后在「通用 › 关于本机 › 证书信任设置」中开启信任。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在「設定」中安裝描述檔，然後在「通用 › 關於本機 › 憑證信任設定」中開啟信任。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「設定」でプロファイルをインストールし、「一般 › 情報 › 証明書信頼設定」で信頼をオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정에서 프로파일을 설치한 후 ‘일반 › 정보 › 인증서 신뢰 설정’에서 신뢰를 켜십시오."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Установите профиль в Настройках, затем включите доверие в разделе Основные › Об этом устройстве › Доверие сертификатам."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instala el perfil en Ajustes y luego activa la confianza en General › Información › Ajustes de confianza de certificados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installez le profil dans Réglages, puis activez la confiance dans Général › Informations › Réglages des certificats."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Installiere das Profil in den Einstellungen und aktiviere dann das Vertrauen unter Allgemein › Info › Zertifikatsvertrauenseinstellungen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Instale o perfil em Ajustes e depois ative a confiança em Geral › Sobre › Ajustes de Confiança de Certificados."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ثبّت ملف التعريف في الإعدادات، ثم فعّل الثقة ضمن عام › حول › إعدادات الثقة بالشهادات."
          }
        }
      }
    },
    "请在「账号」中重新验证 Apple 账号后重试。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Verify your Apple Account on the Account page and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在「账号」中重新验证 Apple 账号后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在「帳號」中重新驗證 Apple 帳號後重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「アカウント」ページで Apple アカウントを確認してから、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정 페이지에서 Apple 계정을 확인한 후 다시 시도하십시오."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подтвердите Аккаунт Apple на странице «Учетная запись» и повторите попытку."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifica tu cuenta de Apple en la página Cuenta e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez votre compte Apple sur la page Compte et réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestätige deinen Apple Account auf der Seite „Account“ und versuche es erneut."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique sua Conta Apple na página Conta e tente de novo."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحقق من حساب Apple من صفحة الحساب وحاول مرة أخرى."
          }
        }
      }
    },
    "请在受信任设备上允许登录，然后输入收到的 6 位验证码。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow the sign-in on a trusted device, then enter the 6-digit code."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在受信任设备上允许登录，然后输入收到的 6 位验证码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在受信任裝置上允許登入，然後輸入收到的 6 位驗證碼。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "信頼できるデバイスでサインインを許可してから、6 桁のコードを入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "신뢰하는 기기에서 로그인을 허용한 후 6자리 코드를 입력하십시오."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите вход на доверенном устройстве, затем введите 6-значный код."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite el inicio de sesión en un dispositivo de confianza e introduce el código de 6 dígitos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez la connexion sur un appareil de confiance, puis saisissez le code à 6 chiffres."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube die Anmeldung auf einem vertrauenswürdigen Gerät und gib dann den 6-stelligen Code ein."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita o início de sessão em um dispositivo confiável e digite o código de 6 dígitos."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسمح بتسجيل الدخول على جهاز موثوق به، ثم أدخل الرمز المكوّن من 6 أرقام."
          }
        }
      }
    },
    "请在系统弹窗中确认安装。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm the installation in the system prompt."
          }
        },
