    "账号验证失效，查询已停止。请重新登录后重试。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "账号验证失效，查询已停止。请重新登录后重试。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Account authentication expired. Search stopped; sign in again and retry."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "帳號驗證失效，查詢已停止。請重新登入後重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウント認証が失効したため検索を停止しました。再ログインしてお試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정 인증이 만료되어 조회를 중단했습니다. 다시 로그인한 후 재시도하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Срок авторизации истёк. Поиск остановлен; войдите снова и повторите попытку."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sesión ha caducado. Se detuvo la búsqueda; inicia sesión y reinténtalo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La session a expiré. Recherche arrêtée ; reconnectez-vous et réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anmeldung abgelaufen. Suche angehalten; erneut anmelden und versuchen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A autenticação expirou. Busca interrompida; entre novamente e tente outra vez."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهت صلاحية المصادقة وتوقف البحث. سجّل الدخول مجددًا وأعد المحاولة."
          }
        }
      }
    },
