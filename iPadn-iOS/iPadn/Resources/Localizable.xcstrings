        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accounts, downloaded packages and purchase records aren't affected."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "账号、已下载的安装包和已购记录不受影响。"
