          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح التفاصيل التقنية لمعرفة الملفات المتبقية؛ يُنصح بإعادة تنزيل ملف IPA الأصلي والمحاولة مجددًا."
          }
        }
      }
    },
    "%lld 个二进制已解密，%lld 个失败，产物里仍有加密内容。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 个二进制已解密，%lld 个失败，产物里仍有加密内容。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld binaries decrypted, %lld failed; the output still contains encrypted code."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 個二進位檔案已解密，%lld 個失敗，產物裡仍有加密內容。"
          }
