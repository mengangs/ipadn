    "已进入系统安装阶段，无法取消": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已进入系统安装阶段，无法取消"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System installation has started and cannot be cancelled"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已進入系統安裝階段，無法取消"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムのインストール段階に入ったためキャンセルできません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 설치 단계에 진입하여 취소할 수 없습니다"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запущена системная установка — отмена невозможна"
