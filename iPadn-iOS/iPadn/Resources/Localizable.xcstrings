    "请等待当前文件处理或暂停完成后再删除": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wait for the file to finish processing or pausing before deleting"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请等待当前文件处理或暂停完成后再删除"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請等待當前檔案處理或暫停完成後再刪除"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
