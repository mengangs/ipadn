          "stringUnit": {
            "state": "translated",
            "value": "Os pacotes baixados também serão apagados."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتم حذف الحزم التي تم تنزيلها أيضًا."
          }
        }
      }
    },
    "已从 App Store 下架，获取过的账号仍可下载，建议尽快备份": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Removed from the App Store. Accounts that acquired it can still download it; back it up soon."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已从 App Store 下架，获取过的账号仍可下载，建议尽快备份"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已從 App Store 下架，取得過的帳號仍可下載，建議儘快備份"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store から削除されました。入手済みのアカウントは引き続きダウンロードできます。早めにバックアップしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store에서 제거되었습니다. 받은 계정은 계속 다운로드할 수 있으니 미리 백업하십시오."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалено из App Store. Учетные записи, получившие его, по-прежнему могут загружать; сохраните резервную копию."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se retiró del App Store. Las cuentas que la obtuvieron aún pueden descargarla; haz una copia pronto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retirée de l’App Store. Les comptes qui l’ont obtenue peuvent encore la télécharger ; sauvegardez-la rapidement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus dem App Store entfernt. Accounts, die sie geladen haben, können sie noch laden; sichere sie bald."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Removido da App Store. As contas que o obtiveram ainda podem baixá-lo; faça backup logo."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أُزيل من App Store. لا يزال بإمكان الحسابات التي حصلت عليه تنزيله، فاحتفظ بنسخة احتياطية قريبًا."
          }
        }
      }
    },
