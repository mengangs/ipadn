        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "System konnte keinen Entschlüsselungskontext erstellen"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O sistema não conseguiu criar o contexto de descriptografia"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر على النظام إنشاء سياق فك التشفير لهذا الترخيص"
          }
        }
      }
    },
    "内核在请求 FairPlay 解密时返回了 ENOMEM（无法分配内存）。这不等于账号或授权有问题，也不能据此判断该 IPA 不可解。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内核在请求 FairPlay 解密时返回了 ENOMEM（无法分配内存）。这不等于账号或授权有问题，也不能据此判断该 IPA 不可解。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The kernel returned ENOMEM (out of memory) during FairPlay decryption. This does not mean the account or license is invalid, nor that this IPA cannot be decrypted."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "核心在請求 FairPlay 解密時傳回了 ENOMEM（無法分配記憶體）。這不等於帳號或授權有問題，也不能據此判斷該 IPA 不可解。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "FairPlay 復号リクエスト時にカーネルが ENOMEM（メモリ割り当て不可）を返しました。アカウントやライセンスの問題とは限らず、復号不能と断定できるものでもありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "FairPlay 복호화 요청 중 커널이 ENOMEM(메모리 할당 불가)을 반환했습니다. 계정이나 라이선스 문제 또는 복호화 불가 상태를 의미하지는 않습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ядро вернуло ENOMEM (нехватка памяти) при запросе FairPlay. Это не означает проблем с аккаунтом или лицензией и не доказывает, что IPA нельзя расшифровать."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El kernel devolvió ENOMEM (sin memoria) al solicitar FairPlay. Esto no implica un problema de cuenta o licencia ni que el IPA no pueda descifrarse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le noyau a renvoyé ENOMEM (mémoire insuffisante) lors du déchiffrement FairPlay. Cela ne signifie pas que le compte ou la licence pose problème."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kernel gab bei FairPlay ENOMEM (Speichermangel) zurück. Das bedeutet weder ein Konto-/Lizenzproblem noch, dass die IPA nicht entschlüsselbar ist."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O kernel retornou ENOMEM (memória insuficiente) na solicitação FairPlay. Isso não indica problema na conta ou licença nem que o IPA não possa ser descriptografado."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أعاد النواة الخطأ ENOMEM (تعذّر تخصيص الذاكرة) أثناء طلب فك تشفير FairPlay. لا يعني هذا وجود مشكلة في الحساب أو الترخيص."
          }
        }
      }
    },
    "稍后重试一次；若持续出现，请保留这个 IPA 与日志反馈，以便按样本分析。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "稍后重试一次；若持续出现，请保留这个 IPA 与日志反馈，以便按样本分析。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Retry shortly. If it keeps occurring, keep this IPA and log for sample analysis."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "稍後重試一次；若持續出現，請保留這個 IPA 與日誌回饋，以便按樣本分析。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "しばらくしてから再試行してください。続く場合は分析のためこの IPA とログを保存してご報告ください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠시 후 다시 시도하세요. 계속 발생하면 샘플 분석을 위해 이 IPA와 로그를 보관해 제보해 주세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Повторите попытку позже. Если ошибка повторяется, сохраните IPA и журнал для анализа."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reintenta más tarde. Si continúa, conserva este IPA y el registro para analizar el caso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réessayez plus tard. Si cela persiste, conservez cet IPA et le journal pour analyse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Versuchen Sie es später erneut. Falls es weiter auftritt, behalten Sie IPA und Protokoll zur Analyse."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tente novamente em breve. Se persistir, guarde este IPA e o log para análise."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أعد المحاولة لاحقًا؛ وإذا استمرت المشكلة فاحتفظ بملف IPA والسجل لتحليله."
          }
        }
      }
    },
    "fairplayd 对这次请求返回了 %@。常见原因有三种：当前设备没有下载该应用所用 Apple 账号的解密授权；IPA 的下载账号与系统 App Store 当前授权账号不一致；这个应用来自家庭共享或其他账号的购买记录。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "fairplayd 对这次请求返回了 %@。常见原因有三种：当前设备没有下载该应用所用 Apple 账号的解密授权；IPA 的下载账号与系统 App Store 当前授权账号不一致；这个应用来自家庭共享或其他账号的购买记录。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "fairplayd returned %@. Common causes: this device lacks decryption authorization for the Apple Account that downloaded the app; the IPA's download account differs from the system App Store account; or the app comes from Family Sharing or another account."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "fairplayd 對這次請求傳回了 %@。常見原因有三種：目前裝置沒有下載該應用所用 Apple 帳號的解密授權；IPA 的下載帳號與系統 App Store 目前授權帳號不一致；這個應用來自家庭共享或其他帳號的購買記錄。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "fairplayd が %@ を返しました。主な原因は3つあります：ダウンロードに使った Apple Account の復号権限がこの端末にない、IPA のダウンロードアカウントと App Store の現在アカウントが異なる、ファミリー共有や別アカウントの購入品である場合です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "fairplayd가 %@를 반환했습니다. 흔한 원인은 세 가지입니다: 이 기기에 해당 앱을 다운로드한 Apple 계정의 복호화 권한이 없거나, IPA 다운로드 계정과 시스템 App Store 계정이 다르거나, 가족 공유 또는 다른 계정의 구매 항목인 경우입니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "fairplayd вернул %@. Три частые причины: на устройстве нет авторизации для аккаунта Apple, скачавшего приложение; аккаунт загрузки IPA отличается от аккаунта App Store; приложение получено через Семейный доступ или другой аккаунт."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "fairplayd devolvió %@. Hay tres causas frecuentes: el dispositivo no tiene autorización de descifrado para la cuenta Apple que descargó la app; la cuenta del IPA difiere de la de App Store; o procede de En familia u otra cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "fairplayd a renvoyé %@. Trois causes fréquentes : l'appareil n'est pas autorisé pour le compte Apple ayant téléchargé l'app ; le compte de l'IPA diffère de celui de l'App Store ; l'app provient du partage familial ou d'un autre compte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "fairplayd hat %@ zurückgegeben. Häufige Ursachen: fehlende Entschlüsselungsautorisierung für das Download-Apple-Konto; abweichendes App-Store-Konto; oder die App stammt aus der Familienfreigabe bzw. einem anderen Konto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "fairplayd retornou %@. Três causas comuns: o dispositivo não tem autorização de descriptografia para a Conta Apple que baixou o app; a conta do IPA difere da App Store do sistema; ou o app veio do Compartilhamento Familiar ou outra conta."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أعاد fairplayd الخطأ %@. الأسباب الشائعة ثلاثة: عدم وجود تفويض فك تشفير على هذا الجهاز لحساب Apple الذي نزّل التطبيق؛ اختلاف حساب تنزيل IPA عن حساب App Store الحالي؛ أو أن التطبيق من المشاركة العائلية أو حساب آخر."
          }
        }
      }
    },
    "用下载该应用时所用的 Apple 账号在系统 App Store 登录一次（App Store → 头像 → 登录），回到这里重新解密。如果已登录仍被拒绝，请核对下载账号是否直接拥有该应用。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用下载该应用时所用的 Apple 账号在系统 App Store 登录一次（App Store → 头像 → 登录），回到这里重新解密。如果已登录仍被拒绝，请核对下载账号是否直接拥有该应用。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in once in the system App Store (App Store → Avatar → Sign In) with the Apple Account used to download this app, then retry decryption here. If still denied, verify that account directly owns the app."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用下載該應用時所用的 Apple 帳號在系統 App Store 登入一次（App Store → 頭像 → 登入），回到這裡重新解密。如果已登入仍被拒絕，請核對下載帳號是否直接擁有該應用。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアプリをダウンロードした Apple Account で標準の App Store に一度サインインし（App Store → プロフィール → サインイン）、戻って再試行してください。サインイン済みでも拒否される場合は、そのアカウントが直接所有しているか確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 앱을 다운로드한 Apple 계정으로 시스템 App Store에 한 번 로그인한 뒤(App Store → 프로필 → 로그인) 다시 복호화해 보세요. 이미 로그인했는데도 거부되면 해당 계정이 앱을 직접 소유하고 있는지 확인하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Войдите в системный App Store (App Store → аватар → Войти) с аккаунтом Apple, которым скачивалось приложение, затем повторите расшифровку. Если отказ сохраняется, проверьте, принадлежит ли приложение напрямую этому аккаунту."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión una vez en el App Store del sistema (App Store → Avatar → Iniciar sesión) con la cuenta Apple que descargó la app y vuelve a intentarlo. Si sigue denegado, comprueba que esa cuenta posea la app directamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous une fois dans l'App Store système (App Store → Avatar → Se connecter) avec le compte Apple utilisé pour le téléchargement, puis réessayez. Si le refus persiste, vérifiez que ce compte détient directement l'app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melden Sie sich einmal im System-App-Store (App Store → Profil → Anmelden) mit dem Apple-Konto des Downloads an und versuchen Sie es erneut. Prüfen Sie bei erneutem Fehler, ob das Konto die App direkt besitzt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Entre uma vez na App Store do sistema (App Store → Avatar → Iniciar sessão) com a Conta Apple usada no download e tente novamente. Se continuar recusado, confirme se a conta possui o app diretamente."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجّل الدخول مرة واحدة في متجر App Store بالنظام (App Store ← الصورة الشخصية ← تسجيل الدخول) بنفس حساب Apple الذي نزّل التطبيق، ثم أعد محاولة فك التشفير هنا. إذا استمر الرفض فتأكد من امتلاك الحساب للتطبيق مباشرة."
          }
        }
      }
    },
    "这个二进制无法解密": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个二进制无法解密"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This binary cannot be decrypted"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個二進位檔案無法解密"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このバイナリは復号できません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 바이너리는 복호화할 수 없습니다"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот бинарный файл нельзя расшифровать"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este binario no puede descifrarse"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce binaire ne peut pas être déchiffré"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Binärdatei kann nicht entschlüsselt werden"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este binário não pode ser descriptografado"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن فك تشفير هذا الملف التنفيذي"
          }
        }
      }
    },
    "内核拒绝了映射参数（EINVAL），该二进制可能不是受支持的加密布局。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内核拒绝了映射参数（EINVAL），该二进制可能不是受支持的加密布局。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The kernel rejected the mapping parameters (EINVAL); this binary may use an unsupported encryption layout."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "核心拒絕了映射參數（EINVAL），該二進位檔案可能不是受支援的加密佈局。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カーネルがマッピング引数を拒否しました（EINVAL）。未対応の暗号化レイアウトの可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "커널이 매핑 매개변수를 거부했습니다(EINVAL). 지원되지 않는 암호화 구조일 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ядро отклонило параметры отображения (EINVAL): возможно, формат шифрования не поддерживается."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El kernel rechazó los parámetros de mapeo (EINVAL); el binario podría tener un formato cifrado no compatible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le noyau a refusé les paramètres de mappage (EINVAL) ; le format de chiffrement de ce binaire n'est peut-être pas pris en charge."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kernel hat die Mapping-Parameter abgelehnt (EINVAL); das Verschlüsselungsformat wird möglicherweise nicht unterstützt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O kernel rejeitou os parâmetros de mapeamento (EINVAL); o binário pode ter um layout de criptografia não suportado."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رفضت النواة معلمات التعيين (EINVAL)؛ قد يستخدم هذا الملف بنية تشفير غير مدعومة."
          }
        }
      }
    },
    "确认包内每个 Mach-O 都有同名的 SC_Info 授权文件；必要时反馈这个样本。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认包内每个 Mach-O 都有同名的 SC_Info 授权文件；必要时反馈这个样本。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check that each Mach-O in the package has its matching SC_Info file, and share this sample if needed."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "確認包內每個 Mach-O 都有同名的 SC_Info 授權檔案；必要時回饋這個樣本。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パッケージ内の各 Mach-O に対応する SC_Info があるか確認し、必要に応じてサンプルをご報告ください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "패키지 내 각 Mach-O에 동일한 이름의 SC_Info 파일이 있는지 확인하고, 필요 시 샘플을 제보해 주세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Убедитесь, что у каждого Mach-O есть соответствующий файл SC_Info; при необходимости отправьте этот образец."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba que cada Mach-O tenga su archivo SC_Info correspondiente y comparte la muestra si es necesario."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez que chaque Mach-O dispose de son fichier SC_Info correspondant et partagez cet échantillon si nécessaire."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfen Sie, ob zu jedem Mach-O eine passende SC_Info-Datei existiert, und melden Sie das Beispiel bei Bedarf."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique se cada Mach-O possui o arquivo SC_Info correspondente e envie a amostra se necessário."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تأكد من وجود ملف SC_Info مطابق لكل Mach-O داخل الحزمة، وأبلغ عن هذه العينة عند الحاجة."
          }
        }
      }
    },
    "解密没有完成": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "解密没有完成"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Decryption did not finish"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "解密沒有完成"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "復号が完了しませんでした"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복호화가 완료되지 않았습니다"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Расшифровка не завершена"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El descifrado no se completó"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le déchiffrement ne s'est pas terminé"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entschlüsselung nicht abgeschlossen"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A descriptografia não foi concluída"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يكتمل فك التشفير"
          }
        }
      }
    },
    "所有加密二进制都被系统拒绝。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有加密二进制都被系统拒绝。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All encrypted binaries were rejected by the system."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所有加密二進位檔案都被系統拒絕。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての暗号化バイナリがシステムにより拒否されました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 암호화 바이너리가 시스템에서 거부되었습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все зашифрованные бинарные файлы были отклонены системой."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los binarios cifrados fueron rechazados por el sistema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les binaires chiffrés ont été refusés par le système."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle verschlüsselten Binärdateien wurden vom System abgelehnt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os binários criptografados foram recusados pelo sistema."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رفض النظام جميع الملفات التنفيذية المشفرة."
          }
        }
      }
    },
    "展开技术详情查看内核返回码与失败文件，然后重试。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "展开技术详情查看内核返回码与失败文件，然后重试。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Expand technical details to inspect the kernel error code and failed files, then retry."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "展開技術詳情檢視核心傳回碼與失敗檔案，然後重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "技術詳細を開いてカーネルのエラーコードと失敗ファイルを確認してから再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기술 세부 정보를 펼쳐 커널 반환 코드와 실패한 파일을 확인한 뒤 다시 시도하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте технические детали, чтобы увидеть код ошибки ядра и проблемные файлы, затем повторите попытку."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Despliega los detalles técnicos para ver el código del kernel y los archivos fallidos, luego reintenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Développez les détails techniques pour consulter le code noyau et les fichiers en échec, puis réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnen Sie die technischen Details für Kernel-Code und fehlgeschlagene Dateien und versuchen Sie es erneut."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Expanda os detalhes técnicos para ver o código do kernel e os arquivos com falha e tente novamente."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح التفاصيل التقنية لمعرفة رمز خطأ النواة والملفات الفاشلة، ثم أعد المحاولة."
          }
        }
      }
    },
    "解密流程结束，但复查产物时发现仍有加密残留或读取失败：%@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "解密流程结束，但复查产物时发现仍有加密残留或读取失败：%@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Decryption finished, but verification still found encrypted sections or read errors: %@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "解密流程結束，但複查產物時發現仍有加密殘留或讀取失敗：%@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "復号処理は終了しましたが、検証で暗号化の残存または読み取りエラーが見つかりました：%@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복호화가 끝났지만 결과물 검증에서 암호화 잔존 또는 읽기 실패가 발견되었습니다: %@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Расшифровка завершилась, но проверка обнаружила оставшееся шифрование или ошибки чтения: %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El descifrado terminó, pero la verificación encontró restos cifrados o errores de lectura: %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le déchiffrement est terminé, mais la vérification a détecté du contenu encore chiffré ou des erreurs de lecture : %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Entschlüsselung ist beendet, aber die Prüfung fand noch verschlüsselte Teile oder Lesefehler: %@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A descriptografia terminou, mas a verificação ainda encontrou trechos criptografados ou erros de leitura: %@"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهى فك التشفير، لكن التحقق وجد بقايا مشفرة أو أخطاء قراءة: %@"
          }
        }
      }
    },
    "展开技术详情确认残留文件；建议重新下载原始 IPA 后重试。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "展开技术详情确认残留文件；建议重新下载原始 IPA 后重试。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Expand technical details to see remaining files; redownload the original IPA and retry."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "展開技術詳情確認殘留檔案；建議重新下載原始 IPA 後重試。"
