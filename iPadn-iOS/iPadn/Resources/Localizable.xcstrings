          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincroniza las compras y descarga las apps para las que tienes licencia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronise les achats et télécharge les apps pour lesquelles vous avez une licence."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronisiert Käufe und lädt Apps, für die du eine Lizenz hast."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincroniza as compras e baixa os apps para os quais você tem licença."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يزامن المشتريات وينزّل التطبيقات المرخّصة لك."
          }
