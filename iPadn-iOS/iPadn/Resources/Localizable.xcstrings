    "应用的多组件下载授权不完整，请重新下载": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app's multi-component download license is incomplete. Download again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用的多组件下载授权不完整，请重新下载"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "應用的多元件下載授權不完整，請重新下載"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "App の複数コンポーネントのダウンロードライセンスが不完全です。もう一度ダウンロードしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱의 다중 구성 요소 다운로드 라이선스가 불완전합니다. 다시 다운로드하십시오."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Лицензия на загрузку компонентов приложения неполная. Загрузите снова."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La licencia de descarga de varios componentes está incompleta. Vuelve a descargar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La licence de téléchargement multicomposant de l’app est incomplète. Téléchargez à nouveau."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Downloadlizenz für die App-Komponenten ist unvollständig. Lade erneut."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A licença de download de vários componentes está incompleta. Baixe novamente."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ترخيص تنزيل المكونات المتعددة للتطبيق غير مكتمل. نزّل مرة أخرى."
          }
        }
      }
    },
    "应用的多组件授权数量与安装包不匹配，请重新下载": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The number of licenses doesn't match the package. Download again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用的多组件授权数量与安装包不匹配，请重新下载"
