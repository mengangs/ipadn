    "安装包已保存在本地，可重试或改为分享。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安装包已保存在本地，可重试或改为分享。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The package is still saved locally. You can retry or share it instead."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "安裝包已儲存在本機，可重試或改為分享。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パッケージはローカルに保存されています。再試行または共有できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "패키지가 로컬에 저장되어 있습니다. 다시 시도하거나 공유할 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пакет сохранён локально — вы можете повторить попытку или поделиться им."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El paquete sigue guardado localmente; puedes reintentarlo o compartirlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le paquet reste enregistré localement ; vous pouvez réessayer ou le partager."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Paket bleibt lokal gespeichert. Du kannst es erneut versuchen oder teilen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O pacote continua salvo localmente; você pode tentar novamente ou compartilhar."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم حفظ الحزمة محليًا؛ يمكنك إعادة المحاولة أو مشاركتها."
          }
        }
      }
    },
    "Apple 已向 %@ 的受信任设备发送登录请求，请在设备上点按「允许」并输入 6 位验证码。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 已向 %@ 的受信任设备发送登录请求，请在设备上点按「允许」并输入 6 位验证码。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple sent a sign-in request to a trusted device for %@. Tap Allow on that device and enter the 6-digit code."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 已向 %@ 的受信任裝置傳送登入要求，請在裝置上點按「允許」並輸入 6 位驗證碼。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple は %@ の信頼されたデバイスにサインイン要求を送信しました。デバイスで「許可」をタップし、6 桁のコードを入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple이 %@의 신뢰할 수 있는 기기로 로그인 요청을 보냈습니다. 기기에서 「허용」을 탭하고 6자리 코드를 입력하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple отправила запрос на вход на доверенное устройство для %@. Нажмите «Разрешить» на устройстве и введите 6-значный код."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple envió una solicitud de inicio de sesión a un dispositivo de confianza de %@. Toca «Permitir» e introduce el código de 6 dígitos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple a envoyé une demande de connexion à un appareil de confiance pour %@. Touchez « Autoriser » et saisissez le code à 6 chiffres."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple hat eine Anmeldeanfrage an ein vertrauenswürdiges Gerät für %@ gesendet. Tippe auf „Erlauben“ und gib den 6-stelligen Code ein."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Apple enviou uma solicitação de início de sessão para um dispositivo confiável de %@. Toque em «Permitir» e digite o código de 6 dígitos."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أرسلت Apple طلب تسجيل دخول إلى جهاز موثوق لحساب %@. اضغط على «السماح» وأدخل رمز التحقق المكون من 6 أرقام."
          }
        }
      }
    },
    "提交验证码": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
