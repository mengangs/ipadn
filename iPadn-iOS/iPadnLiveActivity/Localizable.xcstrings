    "隐私与安全性 › 开发者模式 › 与 %@ 配对": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隐私与安全性 › 开发者模式 › 与 %@ 配对"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Privacy & Security › Developer Mode › Pair with %@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "隱私權與安全性 › 開發者模式 › 與 %@ 配對"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プライバシーとセキュリティ › デベロッパモード › %@ とペアリング"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "개인정보 보호 및 보안 › 개발자 모드 › %@과(와) 페어링"
          }
        }
      }
    },
    "设备已连接，正在生成配对码": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备已连接，正在生成配对码"
