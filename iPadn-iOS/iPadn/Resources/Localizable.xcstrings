            "state": "translated",
            "value": "بدأت مرحلة تثبيت النظام ولا يمكن الإلغاء"
          }
        }
      }
    },
    "正在取消自动安装，请稍后重试删除。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在取消自动安装，请稍后重试删除。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelling automatic installation. Try deleting again in a moment."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在取消自動安裝，請稍後重試刪除。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動インストールをキャンセル中です。しばらくしてからもう一度削除してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동 설치를 취소하는 중입니다. 잠시 후 다시 삭제해 주세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отмена автоустановки. Повторите удаление через мгновение."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelando la instalación automática. Intenta eliminar de nuevo en un momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Annulation de l'installation automatique en cours. Réessayez de supprimer dans un instant."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatische Installation wird abgebrochen. Löschen gleich erneut versuchen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelando a instalação automática. Tente excluir novamente em instantes."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جارٍ إلغاء التثبيت التلقائي. حاول الحذف مرة أخرى بعد لحظة."
          }
        }
      }
    },
    "正在执行系统安装，完成前无法删除该任务。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在执行系统安装，完成前无法删除该任务。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System installation is in progress. This task cannot be removed until it finishes."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在執行系統安裝，完成前無法刪除該任務。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムによるインストールを実行中です。完了するまでこのタスクは削除できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 설치가 진행 중이므로 완료되기 전에 이 작업을 삭제할 수 없습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Идёт системная установка. Задачу нельзя удалить до её завершения."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La instalación del sistema está en curso. No se puede eliminar esta tarea hasta que termine."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'installation système est en cours. Cette tâche ne peut pas être supprimée avant la fin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Systeminstallation läuft. Diese Aufgabe kann erst nach Abschluss entfernt werden."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A instalação do sistema está em andamento. Esta tarefa não pode ser removida antes de terminar."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تثبيت النظام قيد التنفيذ. لا يمكن إزالة هذه المهمة حتى ينتهي."
          }
        }
      }
    },
    "自动安装尚在停止，请稍后重试删除。": {
      "localizations": {
        "zh-Hans": {
