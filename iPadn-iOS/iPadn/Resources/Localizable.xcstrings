    "这个安装包没有声明需要用户授权的权限。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个安装包没有声明需要用户授权的权限。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This package declares no permissions that need your approval."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個安裝包沒有宣告需要使用者授權的權限。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このパッケージには、許可が必要な権限の宣言がありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 패키지는 사용자 승인이 필요한 권한을 선언하지 않습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пакет не запрашивает разрешений, требующих вашего согласия."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este paquete no declara permisos que necesiten tu aprobación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce paquet ne déclare aucune autorisation nécessitant votre accord."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Paket deklariert keine Berechtigungen, die deine Zustimmung erfordern."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este pacote não declara permissões que precisem da sua aprovação."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تعلن هذه الحزمة عن أذونات تتطلب موافقتك."
          }
        }
      }
    },
