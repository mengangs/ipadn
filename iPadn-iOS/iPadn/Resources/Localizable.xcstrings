            "state": "translated",
            "value": "이 앱은 이 계정의 지역에서 판매되지 않습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это приложение не продается в регионе этой учетной записи."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta app no se vende en la región de esta cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette app n’est pas vendue dans la région de ce compte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese App wird in der Region dieses Accounts nicht angeboten."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este app não é vendido na região desta conta."
          }
        },
        "ar": {
