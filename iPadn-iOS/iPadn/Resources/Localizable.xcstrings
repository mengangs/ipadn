    "文件会复制到临时位置，不会改动安装包。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file is copied to a temporary location; the package isn't modified."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件会复制到临时位置，不会改动安装包。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檔案會複製到臨時位置，不會改動安裝包。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルは一時的な場所にコピーされます。パッケージは変更されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일은 임시 위치에 복사되며 패키지는 변경되지 않습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл копируется во временное место; пакет не изменяется."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo se copia a una ubicación temporal; el paquete no se modifica."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier est copié dans un emplacement temporaire ; le paquet n’est pas modifié."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei wird an einen temporären Ort kopiert; das Paket wird nicht verändert."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O arquivo é copiado para um local temporário; o pacote não é alterado."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُنسخ الملف إلى موقع مؤقت؛ لا يتم تعديل الحزمة."
          }
        }
      }
    },
