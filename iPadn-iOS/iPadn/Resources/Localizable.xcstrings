    "%@\n已下载的安装包会保留。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\nDownloaded packages are kept."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n已下载的安装包会保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n已下載的安裝包會保留。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\nダウンロード済みのパッケージは保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n다운로드한 패키지는 유지됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\nЗагруженные пакеты сохранятся."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\nLos paquetes descargados se conservan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\nLes paquets téléchargés sont conservés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\nGeladene Pakete bleiben erhalten."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\nOs pacotes baixados são mantidos."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\nسيتم الاحتفاظ بالحزم التي تم تنزيلها."
          }
        }
      }
    },
    "%@\n这是当前下载账号，移除后将退出登录。\n已下载的安装包会保留。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\nThis is the current download account. Removing it signs you out.\nDownloaded packages are kept."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n这是当前下载账号，移除后将退出登录。\n已下载的安装包会保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n這是當前下載帳號，移除後將退出登入。\n已下載的安裝包會保留。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n現在のダウンロード用アカウントです。削除するとサインアウトします。\nダウンロード済みのパッケージは保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n현재 다운로드 계정입니다. 제거하면 로그아웃됩니다.\n다운로드한 패키지는 유지됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\nЭто текущая учетная запись для загрузки. При удалении вы выйдете из нее.\nЗагруженные пакеты сохранятся."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\nEsta es la cuenta de descarga actual. Al eliminarla, se cerrará la sesión.\nLos paquetes descargados se conservan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\nC’est le compte de téléchargement actuel. Le supprimer vous déconnecte.\nLes paquets téléchargés sont conservés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\nDies ist der aktuelle Download-Account. Beim Entfernen wirst du abgemeldet.\nGeladene Pakete bleiben erhalten."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\nEsta é a conta de download atual. Removê-la encerra a sessão.\nOs pacotes baixados são mantidos."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\nهذا هو حساب التنزيل الحالي. ستؤدي إزالته إلى تسجيل خروجك.\nسيتم الاحتفاظ بالحزم التي تم تنزيلها."
          }
        }
      }
    },
