          "stringUnit": {
            "state": "translated",
            "value": "請在設定中啟用至少一個版本來源"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「設定」でバージョンソースを 1 つ以上有効にしてください"
          }
        },
        "ko": {
          "stringUnit": {
