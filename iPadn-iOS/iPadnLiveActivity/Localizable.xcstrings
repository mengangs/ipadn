          "stringUnit": {
            "state": "translated",
            "value": "Return to %@ to continue installing"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "回到 %@ 繼續安裝"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ に戻ってインストールを続けてください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@(으)로 돌아가 설치를 계속하십시오"
          }
        }
      }
    },
    "回到 %@ 重试": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "回到 %@ 重试"
