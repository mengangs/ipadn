    "本地 IPA 无法读取，已保留原文件；其他任务可继续使用：%@\n%@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't read the local IPA; the original file was kept. Other downloads still work: %@\n%@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地 IPA 无法读取，已保留原文件；其他任务可继续使用：%@\n%@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本地 IPA 無法讀取，已保留原檔案；其他任務可繼續使用：%@\n%@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルの IPA を読み込めませんでした。元のファイルは保持されています。ほかのダウンロードは引き続き使えます: %@\n%@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로컬 IPA를 읽을 수 없습니다. 원본 파일은 유지되었으며 다른 다운로드는 계속 사용할 수 있습니다: %@\n%@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось прочитать локальный IPA; исходный файл сохранен. Другие загрузки работают: %@\n%@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer el IPA local; se conservó el archivo original. Las demás descargas siguen funcionando: %@\n%@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de lire l’IPA local ; le fichier d’origine a été conservé. Les autres téléchargements fonctionnent : %@\n%@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokale IPA konnte nicht gelesen werden; die Originaldatei bleibt erhalten. Andere Downloads funktionieren weiter: %@\n%@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler o IPA local; o arquivo original foi mantido. Os outros downloads continuam funcionando: %@\n%@"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّرت قراءة ملف IPA المحلي؛ تم الاحتفاظ بالملف الأصلي. لا تزال التنزيلات الأخرى تعمل: %@\n%@"
          }
        }
      }
    },
