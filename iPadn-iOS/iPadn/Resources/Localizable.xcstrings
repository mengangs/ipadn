    "当前地区已下架，获取过的账号仍可下载。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Removed in this region; accounts that acquired it can still download it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前地区已下架，获取过的账号仍可下载。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當前地區已下架，取得過的帳號仍可下載。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この地域では販売終了しています。入手済みのアカウントは引き続きダウンロードできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 지역에서 판매가 중지되었습니다. 받은 계정은 계속 다운로드할 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Снято с продажи в этом регионе; получившие его учетные записи по-прежнему могут загружать."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Retirada en esta región; las cuentas que la obtuvieron aún pueden descargarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retirée dans cette région ; les comptes qui l’ont obtenue peuvent encore la télécharger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In dieser Region entfernt; Accounts, die sie geladen haben, können sie noch laden."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Removido nesta região; as contas que o obtiveram ainda podem baixá-lo."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أُزيل في هذه المنطقة؛ لا يزال بإمكان الحسابات التي حصلت عليه تنزيله."
          }
        }
      }
    },
    "当前安装的 iPadn 缺少图标资源，无法更换图标": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This build of iPadn is missing icon assets, so the icon can't be changed"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前安装的 iPadn 缺少图标资源，无法更换图标"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當前安裝的 iPadn 缺少圖示資源，無法更換圖示"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このビルドの iPadn にはアイコンのアセットがないため、アイコンを変更できません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 빌드의 iPadn에는 아이콘 에셋이 없어 아이콘을 변경할 수 없습니다"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В этой сборке iPadn нет ресурсов значков, поэтому значок нельзя сменить"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A esta compilación de iPadn le faltan los recursos de iconos, así que no se puede cambiar el icono"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette version d’iPadn n’a pas les ressources d’icônes ; l’icône ne peut pas être changée"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diesem iPadn-Build fehlen Symbolressourcen, das Symbol kann nicht geändert werden"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta compilação do iPadn não tem os recursos de ícones, então o ícone não pode ser trocado"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفتقد هذا الإصدار من iPadn موارد الأيقونات، لذا لا يمكن تغيير الأيقونة"
          }
        }
      }
    },
    "当前版本不支持下载此 Mac 安装包": {
