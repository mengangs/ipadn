    "App Store 能识别并更新安装的应用": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store 能识别并更新安装的应用"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The App Store recognizes and updates installed apps"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store 能識別並更新安裝的應用"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インストールした App を App Store が認識してアップデートできます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store가 설치한 앱을 인식하고 업데이트할 수 있음"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store распознает и обновляет установленные приложения"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El App Store reconoce y actualiza las apps instaladas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’App Store reconnaît et met à jour les apps installées"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der App Store erkennt und aktualisiert installierte Apps"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A App Store reconhece e atualiza os apps instalados"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتعرّف App Store على التطبيقات المثبّتة ويحدّثها"
          }
        }
      }
    },
    "可以直接覆盖 App Store 安装的应用，数据保留": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可以直接覆盖 App Store 安装的应用，数据保留"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can replace apps installed from the App Store and keep their data"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可以直接覆蓋 App Store 安裝的應用，資料保留"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store からインストールした App をデータを残したまま上書きできます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store에서 설치한 앱을 데이터를 유지한 채 덮어쓸 수 있음"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Может заменять приложения, установленные из App Store, сохраняя их данные"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede reemplazar apps instaladas desde el App Store y conservar sus datos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Peut remplacer des apps installées depuis l’App Store en conservant leurs données"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kann aus dem App Store installierte Apps ersetzen und ihre Daten behalten"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pode substituir apps instalados pela App Store e manter os dados"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنه استبدال التطبيقات المثبّتة من App Store مع الاحتفاظ ببياناتها"
          }
        }
      }
