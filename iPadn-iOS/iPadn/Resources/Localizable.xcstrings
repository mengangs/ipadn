    "%@。打开 iPadn 下载新版本。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Open iPadn to download the new version."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@。打开 iPadn 下载新版本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@。開啟 iPadn 下載新版本。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@。iPadn を開いて新しいバージョンをダウンロードしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. iPadn을 열어 새 버전을 다운로드하십시오."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Откройте iPadn, чтобы загрузить новую версию."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Abre iPadn para descargar la nueva versión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Ouvrez iPadn pour télécharger la nouvelle version."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Öffne iPadn, um die neue Version zu laden."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Abra o iPadn para baixar a nova versão."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. افتح iPadn لتنزيل الإصدار الجديد."
          }
        }
      }
    },
