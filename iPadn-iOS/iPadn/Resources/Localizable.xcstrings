        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 iPadn，搜索名称、App ID、商店链接或 App ID 与版本 ID。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟 iPadn，搜尋名稱、App ID、商店連結或 App ID 與版本 ID。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPadn を開き、名前、App ID、ストアのリンク、または App ID とバージョン ID で検索します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPadn을 열고 이름, App ID, 스토어 링크 또는 App ID와 버전 ID로 검색합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте iPadn и ищите по названию, App ID, ссылке на магазин или App ID с ID версии."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre iPadn y busca por nombre, App ID, enlace de la tienda o App ID con ID de versión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez iPadn et recherchez par nom, App ID, lien du Store ou App ID avec ID de version."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne iPadn und suche nach Name, App-ID, Store-Link oder App-ID mit Versions-ID."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra o iPadn e busque por nome, App ID, link da loja ou App ID com ID de versão."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح iPadn وابحث بالاسم أو App ID أو رابط المتجر أو App ID مع معرّف الإصدار."
          }
        }
      }
    },
    "打开后可以浏览安装包内容、查看账号令牌和修改设备标识。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turns on browsing package contents, viewing account tokens and changing the device identifier."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开后可以浏览安装包内容、查看账号令牌和修改设备标识。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟後可以瀏覽安裝包內容、檢視帳號令牌和修改裝置標識。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パッケージ内容の閲覧、アカウントトークンの表示、デバイス識別子の変更をオンにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "패키지 내용 살펴보기, 계정 토큰 보기, 기기 식별자 변경을 켭니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включает просмотр содержимого пакетов, токенов учетной записи и смену идентификатора устройства."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa explorar el contenido de los paquetes, ver los tokens de la cuenta y cambiar el identificador del dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Active la consultation du contenu des paquets, l’affichage des jetons du compte et la modification de l’identifiant de l’appareil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviert das Durchsuchen von Paketinhalten, das Anzeigen von Account-Tokens und das Ändern der Gerätekennung."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ativa explorar o conteúdo dos pacotes, ver tokens da conta e alterar o identificador do dispositivo."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفعّل تصفّح محتويات الحزم وعرض الرموز المميزة للحساب وتغيير معرّف الجهاز."
          }
        }
      }
    },
