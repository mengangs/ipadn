          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Требуются уже настроенные правила прокси."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Requiere reglas de proxy que ya hayas configurado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nécessite des règles de proxy déjà configurées."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfordert bereits eingerichtete Proxy-Regeln."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Requer regras de proxy já configuradas."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتطلب قواعد وكيل أعددتها مسبقًا."
          }
        }
      }
    },
    "需要重新安装并信任新的描述文件。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You'll need to install and trust the new profile."
          }
        },
        "zh-Hans": {
