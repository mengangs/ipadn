    "请先连接 Wi‑Fi，电脑也需要在同一网络中。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先连接 Wi‑Fi，电脑也需要在同一网络中。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect to Wi‑Fi first; the computer needs to be on the same network."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先連接 Wi‑Fi，電腦也需要在同一網路中。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "先にWi‑Fiに接続してください。コンピュータも同じネットワークにある必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 Wi‑Fi에 연결하세요. 컴퓨터도 같은 네트워크에 있어야 합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала подключитесь к Wi‑Fi; компьютер должен быть в той же сети."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conéctate primero a una Wi‑Fi; el ordenador debe estar en la misma red."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous d’abord au Wi‑Fi ; l’ordinateur doit être sur le même réseau."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbinde dich zuerst mit einem WLAN; der Computer muss im selben Netzwerk sein."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecte-se primeiro a uma Wi‑Fi; o computador precisa estar na mesma rede."
          }
        },
        "ar": {
