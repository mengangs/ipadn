    "该应用尚未在这个账号所属地区上架。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This app isn't sold in this account's region."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该应用尚未在这个账号所属地区上架。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "該應用尚未在這個帳號所屬地區上架。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この App はこのアカウントの地域では販売されていません。"
          }
        },
        "ko": {
