    "设备标识或账号标识无效，请重新登录": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The device or account identifier is invalid. Sign in again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备标识或账号标识无效，请重新登录"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "裝置標識或帳號標識無效，請重新登入"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスまたはアカウントの識別子が無効です。もう一度サインインしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기 또는 계정 식별자가 유효하지 않습니다. 다시 로그인하십시오."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Недопустимый идентификатор устройства или учетной записи. Войдите снова."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El identificador del dispositivo o de la cuenta no es válido. Vuelve a iniciar sesión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’identifiant de l’appareil ou du compte n’est pas valide. Reconnectez-vous."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Geräte- oder Account-Kennung ist ungültig. Melde dich erneut an."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O identificador do dispositivo ou da conta é inválido. Inicie a sessão novamente."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "معرّف الجهاز أو الحساب غير صالح. سجّل الدخول مرة أخرى."
          }
        }
      }
    },
    "设备标识无效，请检查专业模式设置": {
      "localizations": {
        "en": {
