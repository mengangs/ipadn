          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Libérez de l'espace et réessayez ; le déchiffrement utilise temporairement l'équivalent d'un IPA."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geben Sie Speicherplatz frei und versuchen Sie es erneut; während der Entschlüsselung wird vorübergehend ca. eine IPA-Größe belegt."
          }
        },
        "pt-BR": {
