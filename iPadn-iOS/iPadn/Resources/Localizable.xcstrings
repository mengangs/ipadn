            "state": "translated",
            "value": "Die Systeminstallation hat begonnen und kann nicht abgebrochen werden"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A instalação do sistema já começou e não pode ser cancelada"
          }
        },
        "ar": {
