    "需要先在「安装设置」里连接本机通道，并保持 Wi-Fi 开启": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要先在「安装设置」里连接本机通道，并保持 Wi-Fi 开启"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect the on-device channel in Installation Settings first, and keep Wi-Fi on."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先在「安裝設定」中連接本機通道，並保持 Wi-Fi 開啟"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "先に「インストール設定」でデバイス内チャネルを接続し、Wi-Fi をオンにしてください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 「설치 설정」에서 기기 내 채널을 연결하고 Wi-Fi를 켜 두세요"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала подключите локальный канал в «Настройках установки» и оставьте Wi-Fi включённым"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecta primero el canal local en «Ajustes de instalación» y mantén el Wi-Fi activado"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez d'abord le canal local dans « Réglages d'installation » et laissez le Wi-Fi activé"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbinde zuerst den lokalen Kanal in den „Installationseinstellungen“ und lasse WLAN aktiviert"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecte o canal local em «Ajustes de instalação» primeiro e mantenha o Wi-Fi ativado"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بتوصيل القناة المحلية في «إعدادات التثبيت» أولاً، وأبقِ Wi-Fi قيد التشغيل"
          }
        }
      }
    },
    "OTA 需要已签名（或已解密并签名）的安装包": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "OTA 需要已签名（或已解密并签名）的安装包"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OTA requires a signed (or decrypted and signed) package"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "OTA 需要已簽署（或已解密並簽署）的安裝包"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "OTA には署名済み（または復号・署名済み）のパッケージが必要です"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "OTA에는 서명된(또는 복호화 후 서명된) 패키지가 필요합니다"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для OTA нужен подписанный (или расшифрованный и подписанный) пакет"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "OTA requiere un paquete firmado (o descifrado y firmado)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "OTA nécessite un paquet signé (ou déchiffré et signé)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "OTA erfordert ein signiertes (oder entschlüsseltes und signiertes) Paket"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "OTA requer um pacote assinado (ou descriptografado e assinado)"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتطلب OTA حزمة موقّعة (أو مفكوكة التشفير وموقّعة)"
          }
        }
      }
    },
