    "用于同步已购项目和下载你拥有许可的应用。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Syncs purchases and downloads apps you're licensed to use."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于同步已购项目和下载你拥有许可的应用。"
          }
        },
        "zh-Hant": {
