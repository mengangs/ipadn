        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したバージョンはダウンロードできません。別のバージョンをお試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 버전을 다운로드할 수 없습니다. 다른 버전을 시도하십시오."
          }
        },
        "ru": {
