    "汇率为 %@ 的参考中间价，实际扣款以发卡银行为准。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mid-market reference rate as of %@; your card issuer sets the amount charged."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "汇率为 %@ 的参考中间价，实际扣款以发卡银行为准。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "匯率為 %@ 的參考中間價，實際扣款以髮卡銀行為準。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 時点の参考仲値です。実際の請求額はカード発行会社が決定します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 기준 참고 중간 환율이며, 실제 청구 금액은 카드 발급사가 정합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Средний рыночный курс на %@; итоговую сумму списания определяет банк-эмитент карты."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tipo de cambio medio de mercado a fecha de %@; el emisor de tu tarjeta fija el importe cobrado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Taux médian du marché au %@ ; l’émetteur de votre carte fixe le montant débité."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mittelkurs vom %@; der tatsächlich belastete Betrag hängt von deinem Kartenanbieter ab."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Taxa média de mercado em %@; o emissor do seu cartão define o valor cobrado."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سعر السوق المتوسط بتاريخ %@؛ تحدد الجهة المُصدِرة لبطاقتك المبلغ المُحصَّل."
          }
        }
      }
    },
