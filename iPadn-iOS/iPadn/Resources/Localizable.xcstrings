    "Apple 未接受本次验证。请检查账号密码，并输入最新的 6 位验证码后重试。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple didn't accept this verification. Check the account password and enter the latest 6-digit code."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 未接受本次验证。请检查账号密码，并输入最新的 6 位验证码后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 未接受本次驗證。請檢查帳號密碼，並輸入最新的 6 位驗證碼後重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple はこの確認を受け付けませんでした。アカウントのパスワードを確認し、最新の 6 桁のコードを入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple이 이 확인을 받아들이지 않았습니다. 계정 암호를 확인하고 최신 6자리 코드를 입력하십시오."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple не приняла эту проверку. Проверьте пароль учетной записи и введите последний 6-значный код."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple no aceptó esta verificación. Revisa la contraseña de la cuenta e introduce el código de 6 dígitos más reciente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple n’a pas accepté cette vérification. Vérifiez le mot de passe du compte et saisissez le dernier code à 6 chiffres."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple hat diese Bestätigung nicht akzeptiert. Prüfe das Accountpasswort und gib den neuesten 6-stelligen Code ein."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Apple não aceitou esta verificação. Confira a senha da conta e digite o código de 6 dígitos mais recente."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تقبل Apple عملية التحقق هذه. تحقق من كلمة سر الحساب وأدخل أحدث رمز مكوّن من 6 أرقام."
          }
        }
      }
    },
    "Apple 未返回完整登录信息，请重试": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple didn't return complete sign-in details. Try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 未返回完整登录信息，请重试"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 未返回完整登入資訊，請重試"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple からサインイン情報が完全に返されませんでした。もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple이 로그인 정보를 완전히 반환하지 않았습니다. 다시 시도하십시오."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple вернула неполные данные для входа. Повторите попытку."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple no devolvió todos los datos de inicio de sesión. Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple n’a pas renvoyé toutes les informations de connexion. Réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple hat die Anmeldedaten nicht vollständig zurückgegeben. Versuche es erneut."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Apple não retornou todos os dados de início de sessão. Tente novamente."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تُرجع Apple بيانات تسجيل الدخول كاملة. حاول مرة أخرى."
          }
        }
      }
    },
    "Apple 未返回有效的登录数据，请稍后重试或切换网络。仍然失败可在设置中导出诊断信息。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple didn't return valid sign-in data. Try again later or switch networks. If it keeps failing, export diagnostics in Settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 未返回有效的登录数据，请稍后重试或切换网络。仍然失败可在设置中导出诊断信息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 未返回有效的登入資料，請稍後重試或切換網路。仍然失敗可在設定中匯出診斷資訊。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple から有効なサインインデータが返されませんでした。しばらくしてから再試行するか、ネットワークを切り替えてください。解決しない場合は「設定」で診断情報を書き出してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple이 유효한 로그인 데이터를 반환하지 않았습니다. 나중에 다시 시도하거나 네트워크를 변경하십시오. 계속 실패하면 설정에서 진단 정보를 내보내십시오."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple не вернула действительные данные для входа. Повторите попытку позже или смените сеть. Если ошибка повторяется, экспортируйте диагностику в Настройках."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple no devolvió datos de inicio de sesión válidos. Inténtalo más tarde o cambia de red. Si sigue fallando, exporta el diagnóstico en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple n’a pas renvoyé de données de connexion valides. Réessayez plus tard ou changez de réseau. Si le problème persiste, exportez les diagnostics dans Réglages."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple hat keine gültigen Anmeldedaten zurückgegeben. Versuche es später erneut oder wechsle das Netzwerk. Wenn es weiter fehlschlägt, exportiere die Diagnose in den Einstellungen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Apple não retornou dados de início de sessão válidos. Tente mais tarde ou mude de rede. Se continuar falhando, exporte o diagnóstico em Ajustes."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تُرجع Apple بيانات تسجيل دخول صالحة. حاول لاحقًا أو غيّر الشبكة. إذا استمر الفشل، فقم بتصدير بيانات التشخيص من الإعدادات."
          }
        }
      }
    },
    "Apple 未返回登录信息，请检查账号后重试。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple didn't return sign-in details. Check the account and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 未返回登录信息，请检查账号后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 未返回登入資訊，請檢查帳號後重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple からサインイン情報が返されませんでした。アカウントを確認してもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple이 로그인 정보를 반환하지 않았습니다. 계정을 확인하고 다시 시도하십시오."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple не вернула данные для входа. Проверьте учетную запись и повторите попытку."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple no devolvió los datos de inicio de sesión. Revisa la cuenta e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple n’a pas renvoyé les informations de connexion. Vérifiez le compte et réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple hat keine Anmeldedaten zurückgegeben. Prüfe den Account und versuche es erneut."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Apple não retornou os dados de início de sessão. Confira a conta e tente novamente."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تُرجع Apple بيانات تسجيل الدخول. تحقق من الحساب وحاول مرة أخرى."
          }
        }
      }
    },
    "Apple 没有返回该版本的下载信息": {
      "localizations": {
        "en": {
