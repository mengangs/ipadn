          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se agotó el tiempo del entorno de verificación local. Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’environnement de vérification local a expiré. Réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
