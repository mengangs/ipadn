    "安装包不会离开这台设备": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The package never leaves this device"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安装包不会离开这台设备"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "安裝包不會離開這臺裝置"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パッケージがこのデバイスの外に送られることはありません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "패키지는 이 기기 밖으로 나가지 않습니다"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пакет не покидает это устройство"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El paquete nunca sale de este dispositivo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le paquet ne quitte jamais cet appareil"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Paket verlässt dieses Gerät nie"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O pacote nunca sai deste dispositivo"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تغادر الحزمة هذا الجهاز أبدًا"
          }
        }
      }
    },
    "安装包中没有文件": {
      "localizations": {
