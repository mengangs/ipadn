    "若返回 {\"data\":[…]}，列表容器键填写 data。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If the response is {\"data\":[…]}, use data as the list field name."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "若返回 {\"data\":[…]}，列表容器键填写 data。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "若返回 {\"data\":[…]}，列表容器鍵填寫 data。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "応答が {\"data\":[…]} の場合は、リストのフィールド名に data を指定します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "응답이 {\"data\":[…]}이면 목록 필드 이름에 data를 입력하십시오."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если ответ имеет вид {\"data\":[…]}, укажите data как имя поля списка."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si la respuesta es {\"data\":[…]}, usa data como nombre del campo de la lista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si la réponse est {\"data\":[…]}, utilisez data comme nom du champ de liste."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lautet die Antwort {\"data\":[…]}, verwende data als Namen des Listenfelds."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se a resposta for {\"data\":[…]}, use data como nome do campo da lista."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذا كانت الاستجابة {\"data\":[…]}، فاستخدم data اسمًا لحقل القائمة."
          }
        }
      }
    },
