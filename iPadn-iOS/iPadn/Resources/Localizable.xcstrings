        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya comenzó la instalación del sistema y no se puede cancelar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'installation système a commencé et ne peut pas être annulée"
          }
        },
        "de": {
