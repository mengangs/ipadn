            "value": "لا توجد ملفات IPA أصلية بعد. استخدم الاستيراد لإضافتها."
          }
        }
      }
    },
    "还没有处理记录": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有处理记录"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No processing history yet"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還沒有處理記錄"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "処理履歴はまだありません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 처리 기록 없음"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "История пока пуста"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay historial"
          }
        },
        "fr": {
          "stringUnit": {
