          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "라이선스 수가 패키지와 일치하지 않습니다. 다시 다운로드하십시오."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
