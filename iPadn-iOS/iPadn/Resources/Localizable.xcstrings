    "\n\n…（仅显示前 %lld 个字符，完整内容请提取后查看）": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n…(showing the first %lld characters; extract the file to see the rest)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n…（仅显示前 %lld 个字符，完整内容请提取后查看）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n…（僅顯示前 %lld 個字元，完整內容請提取後檢視）"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n…（最初の %lld 文字を表示しています。残りはファイルを取り出して確認してください）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n…(처음 %lld자를 표시하고 있습니다. 나머지는 파일을 추출하여 확인하십시오)"
          }
        }
      }
    },
