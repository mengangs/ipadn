    "当前只有蜂窝数据，下载会在连上 Wi‑Fi 后继续。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前只有蜂窝数据，下载会在连上 Wi‑Fi 后继续。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only cellular data is available. Downloads continue on Wi‑Fi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前只有行動數據，下載會在連上 Wi‑Fi 後繼續。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在はモバイルデータ通信のみです。Wi‑Fiにつながるとダウンロードを再開します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 셀룰러 데이터만 사용할 수 있습니다. Wi‑Fi에 연결되면 다운로드가 계속됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сейчас доступна только сотовая сеть. Загрузки продолжатся по Wi‑Fi."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo hay datos móviles. Las descargas continuarán con Wi‑Fi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seules les données cellulaires sont disponibles. Les téléchargements reprendront en Wi‑Fi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerade ist nur Mobilfunk verfügbar. Downloads laufen im WLAN weiter."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só há dados celulares agora. Os downloads continuam no Wi‑Fi."
          }
        },
        "ar": {
