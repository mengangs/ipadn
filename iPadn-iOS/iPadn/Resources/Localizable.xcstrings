          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les taux de change sont indisponibles ; seuls les prix locaux sont affichés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wechselkurse sind nicht verfügbar, daher werden nur lokale Preise angezeigt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
