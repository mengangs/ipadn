        }
      }
    },
    "安装包保存在 iPadn 中，也可以在「文件」App 的「我的 iPhone › iPadn › Packages」中查看。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Packages are kept in iPadn. You can also find them in the Files app under On My iPhone › iPadn › Packages."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安装包保存在 iPadn 中，也可以在「文件」App 的「我的 iPhone › iPadn › Packages」中查看。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "安裝包儲存在 iPadn 中，也可以在「檔案」App 的「我的 iPhone › iPadn › Packages」中檢視。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パッケージは iPadn に保存されます。「ファイル」App の「このiPhone内 › iPadn › Packages」でも確認できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "패키지는 iPadn에 보관됩니다. 파일 앱의 ‘나의 iPhone › iPadn › Packages’에서도 찾을 수 있습니다."
          }
        }
      }
    },
    "安装包信息不完整，无法安装": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
