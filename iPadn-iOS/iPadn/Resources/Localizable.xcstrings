            "state": "translated",
            "value": "ネイティブインストールには iOS 17.4 以降が必要です"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "네이티브 설치에는 iOS 17.4 이상이 필요합니다"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нативная установка требует iOS 17.4 или новее"
          }
        },
        "es": {
