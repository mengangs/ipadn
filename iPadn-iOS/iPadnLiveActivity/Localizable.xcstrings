    "回到 %@ 继续安装": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "回到 %@ 继续安装"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Return to %@ to continue installing"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "回到 %@ 繼續安裝"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ に戻ってインストールを続けてください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@(으)로 돌아가 설치를 계속하십시오"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вернитесь в %@, чтобы продолжить установку"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a %@ para seguir instalando"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Revenez dans %@ pour poursuivre l’installation"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kehre zu %@ zurück, um fortzufahren"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Volte ao %@ para continuar a instalação"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عُد إلى %@ لمتابعة التثبيت"
          }
        }
      }
    },
