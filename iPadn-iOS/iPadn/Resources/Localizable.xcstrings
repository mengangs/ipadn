    "将文件导入 iPadn，并打开下载管理。可用于分享菜单中的快捷指令。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Imports a file into iPadn and opens Downloads. Useful for a shortcut in the share sheet."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将文件导入 iPadn，并打开下载管理。可用于分享菜单中的快捷指令。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將檔案匯入 iPadn，並開啟下載管理。可用於分享選單中的快捷指令。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルを iPadn に読み込み、「ダウンロード」を開きます。共有シートのショートカットに便利です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일을 iPadn으로 가져오고 다운로드를 엽니다. 공유 시트의 단축어에 유용합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Импортирует файл в iPadn и открывает «Загрузки». Удобно для быстрой команды в меню «Поделиться»."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Importa un archivo en iPadn y abre Descargas. Útil para un atajo en la hoja de compartir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Importe un fichier dans iPadn et ouvre Téléchargements. Pratique pour un raccourci dans la feuille de partage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Importiert eine Datei in iPadn und öffnet „Downloads“. Praktisch für einen Kurzbefehl im Teilen-Menü."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Importa um arquivo para o iPadn e abre Downloads. Útil para um atalho na planilha de compartilhamento."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستورد ملفًا إلى iPadn ويفتح التنزيلات. مفيد لاختصار في ورقة المشاركة."
          }
        }
      }
    },
    "将释放 %@。每个应用保留最新下载的版本。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Frees %@. The newest download of each app is kept."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将释放 %@。每个应用保留最新下载的版本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將釋放 %@。每個應用保留最新下載的版本。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ を解放します。各 App の最新のダウンロードは保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@를 확보합니다. 앱마다 최신 다운로드는 유지됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Освободит %@. Самая новая загрузка каждого приложения сохранится."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Libera %@. Se conserva la descarga más reciente de cada app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Libère %@. Le téléchargement le plus récent de chaque app est conservé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gibt %@ frei. Der neueste Download jeder App bleibt erhalten."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Libera %@. O download mais recente de cada app é mantido."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحرّر %@. يُحتفظ بأحدث تنزيل لكل تطبيق."
          }
        }
      }
    },
