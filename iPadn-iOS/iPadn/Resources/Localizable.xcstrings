          "stringUnit": {
            "state": "translated",
            "value": "Apple에서 작업을 완료할 수 없습니다. 잠시 후 다시 시도하세요(코드 %@)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Apple não conseguiu concluir a operação. Tente novamente mais tarde (código %@)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple не удалось завершить операцию. Повторите попытку позже (код %@)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 暂时无法完成该操作，请稍后重试（代码 %@）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 暫時無法完成該操作，請稍後重試（代碼 %@）。"
          }
        }
      }
    },
    "此 Apple 账号已被停用，请先在 Apple 官网或系统设置中恢复后再试。": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم تعطيل حساب Apple هذا. استرده عبر موقع Apple أو في الإعدادات ثم حاول مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Apple Account ist deaktiviert. Stelle ihn auf der Apple-Website oder in den Einstellungen wieder her und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Apple Account is disabled. Recover it on Apple's website or in Settings, then try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta Cuenta de Apple está desactivada. Recupérala en el sitio web de Apple o en Ajustes y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce compte Apple est désactivé. Récupérez-le sur le site d’Apple ou dans Réglages, puis réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Apple Account は無効になっています。Apple の公式サイトまたは設定で復旧してからやり直してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Apple 계정이 비활성화되었습니다. Apple 웹사이트나 설정에서 복구한 뒤 다시 시도하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta Conta Apple está desativada. Recupere-a no site da Apple ou nos Ajustes e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот Аккаунт Apple отключён. Восстановите его на сайте Apple или в Настройках и повторите попытку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Apple 账号已被停用，请先在 Apple 官网或系统设置中恢复后再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Apple 帳號已被停用，請先在 Apple 官網或系統設定中恢復後再試。"
          }
        }
      }
    },
    "Apple 账号密码已更改，请重新登录。": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم تغيير كلمة سر حساب Apple. يرجى تسجيل الدخول مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Passwort deines Apple Accounts wurde geändert. Melde dich erneut an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Apple Account password has changed. Sign in again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La contraseña de tu Cuenta de Apple ha cambiado. Vuelve a iniciar sesión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mot de passe de votre compte Apple a été modifié. Veuillez vous reconnecter."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Account のパスワードが変更されました。再度サインインしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 계정 암호가 변경되었습니다. 다시 로그인하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A senha da sua Conta Apple foi alterada. Inicie sessão novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пароль Аккаунта Apple был изменён. Войдите снова."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 账号密码已更改，请重新登录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 帳號密碼已變更，請重新登入。"
          }
        }
      }
    },
    "Apple 需要您先同意最新的 App Store 条款与条件，请先在系统 App Store 中同意后再试。": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتطلب Apple موافقتك على أحدث شروط وأحكام App Store. وافق عليها في تطبيق App Store ثم حاول مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple verlangt deine Zustimmung zu den aktuellen App Store-Nutzungsbedingungen. Stimme ihnen in der App Store-App zu und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple requires you to agree to the latest App Store Terms and Conditions. Accept them in the App Store app and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple requiere que aceptes los últimos Términos y condiciones de App Store. Acéptalos en la app App Store y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple exige d’accepter les dernières conditions générales de l’App Store. Acceptez-les dans l’app App Store puis réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple から最新の App Store 利用規約への同意が求められています。App Store アプリで同意してからやり直してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple에서 최신 App Store 이용 약관 동의를 요청하고 있습니다. App Store 앱에서 동의한 후 다시 시도하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Apple exige que você concorde com os Termos e Condições mais recentes da App Store. Aceite-os no app App Store e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple требует принять обновлённые Условия и положения App Store. Примите их в приложении App Store и повторите попытку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 需要您先同意最新的 App Store 条款与条件，请先在系统 App Store 中同意后再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 需要您先同意最新的 App Store 條款與條件，請先在系統 App Store 中同意後再試。"
          }
        }
      }
    },
    "Apple 已向 %@ 发送 6 位短信验证码，请等待本次最新短信送达后输入。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 已向 %@ 发送 6 位短信验证码，请等待本次最新短信送达后输入。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple sent a 6-digit SMS verification code to %@. Wait for the new text message and enter it below."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 已向 %@ 傳送 6 位數簡訊驗證碼，請等待本次最新簡訊送達後輸入。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple が %@ に 6 桁の SMS 確認コードを送信しました。最新のメッセージが届いてから入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple이 %@(으)로 6자리 SMS 인증 코드를 보냈습니다. 새 문자가 도착하면 입력해 주세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple отправила 6-значный SMS-код на %@. Дождитесь нового сообщения и введите код."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple envió un código SMS de 6 dígitos a %@. Espera el nuevo mensaje e ingrésalo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple a envoyé un code SMS à 6 chiffres au %@. Attendez le nouveau message avant de le saisir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple hat einen 6-stelligen SMS-Code an %@ gesendet. Warte auf die neue Nachricht und gib ihn ein."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Apple enviou um código SMS de 6 dígitos para %@. Aguarde a nova mensagem e digite-o."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أرسلت Apple رمز تحقق SMS مكوّنًا من 6 أرقام إلى %@. انتظر وصول الرسالة الجديدة ثم أدخله."
          }
        }
      }
    },
    "Apple 已向 %@ 的受信任手机号发送 6 位短信验证码，请等待本次最新短信送达后输入。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 已向 %@ 的受信任手机号发送 6 位短信验证码，请等待本次最新短信送达后输入。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple sent a 6-digit SMS verification code to a trusted phone number for %@. Wait for the new message and enter it below."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 已向 %@ 的受信任手機號碼傳送 6 位數簡訊驗證碼，請等待本次最新簡訊送達後輸入。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple が %@ の信頼できる電話番号に 6 桁の SMS 確認コードを送信しました。最新のメッセージが届いてから入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple이 %@의 신뢰할 수 있는 전화번호로 6자리 SMS 인증 코드를 보냈습니다. 새 문자가 도착하면 입력해 주세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple отправила 6-значный SMS-код на доверенный номер для %@. Дождитесь нового сообщения и введите код."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple envió un código SMS de 6 dígitos al teléfono de confianza de %@. Espera el nuevo mensaje e ingrésalo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple a envoyé un code SMS à 6 chiffres au numéro de confiance de %@. Attendez le nouveau message avant de le saisir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple hat einen 6-stelligen SMS-Code an eine vertrauenswürdige Nummer für %@ gesendet. Warte auf die neue Nachricht und gib ihn ein."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Apple enviou um código SMS de 6 dígitos para o número confiável de %@. Aguarde a nova mensagem e digite-o."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أرسلت Apple رمز تحقق SMS مكوّنًا من 6 أرقام إلى رقم الهاتف الموثوق لحساب %@. انتظر وصول الرسالة الجديدة ثم أدخله."
          }
        }
      }
    },
    "请勿填入之前收到的旧短信验证码；如暂未收到短信，可稍候几秒或取消后重新尝试。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请勿填入之前收到的旧短信验证码；如暂未收到短信，可稍候几秒或取消后重新尝试。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do not enter an older SMS code. If the message hasn't arrived yet, wait a few seconds or cancel and try again."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請勿填入先前收到的舊簡訊驗證碼；如暫未收到簡訊，可稍候幾秒或取消後重新嘗試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "以前に受信した古い SMS コードは入力しないでください。届かない場合は数秒待つか、キャンセルしてやり直してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이전에 받은 오래된 SMS 코드는 입력하지 마세요. 문자가 오지 않으면 잠시 기다리거나 취소 후 다시 시도하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вводите старый код из предыдущих SMS. Если сообщение ещё не пришло, подождите несколько секунд или отмените и повторите."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No ingreses un código SMS antiguo. Si aún no llega, espera unos segundos o cancela e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "N'utilisez pas un ancien code SMS. Si le message n'est pas encore arrivé, patientez quelques secondes ou annulez et réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib keinen älteren SMS-Code ein. Falls die Nachricht noch nicht angekommen ist, warte kurz oder brich ab und versuche es erneut."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não digite um código SMS antigo. Se a mensagem ainda não chegou, aguarde alguns segundos ou cancele e tente novamente."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تُدخل رمز SMS قديمًا. إذا لم تصل الرسالة بعد، انتظر بضع ثوانٍ أو ألغِ وحاول مجددًا."
          }
        }
      }
    },
    "若未收到受信任设备弹窗，请在已登录该账号的设备上前往「设置 › Apple 账户 › 登录与安全 › 获取验证码」，输入显示的 6 位验证码即可。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "若未收到受信任设备弹窗，请在已登录该账号的设备上前往「设置 › Apple 账户 › 登录与安全 › 获取验证码」，输入显示的 6 位验证码即可。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If no prompt appears on your trusted device, open Settings › Apple Account › Sign-In & Security › Get Verification Code on a signed-in device and enter the 6-digit code."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "若未收到受信任裝置彈窗，請在已登入該帳號的裝置上前往「設定 › Apple 帳號 › 登入與安全性 › 取得驗證碼」，輸入顯示的 6 位數驗證碼即可。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "信頼できるデバイスに通知が表示されない場合は、サインイン済みデバイスで「設定 › Apple Account › サインインとセキュリティ › 確認コードを入手」を開き、6 桁のコードを入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "신뢰할 수 있는 기기에 팝업이 표시되지 않으면 로그인된 기기에서 '설정 › Apple 계정 › 로그인 및 보안 › 인증 코드 받기'로 이동해 6자리 코드를 입력하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если запрос не появился на доверенном устройстве, откройте «Настройки › Аккаунт Apple › Вход и безопасность › Получить код проверки» и введите 6-значный код."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si no recibes el aviso en un dispositivo de confianza, ve a Ajustes › Cuenta de Apple › Inicio de sesión y seguridad › Obtener código de verificación e ingresa el código de 6 dígitos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si aucune invite n'apparaît sur votre appareil de confiance, ouvrez Réglages › Compte Apple › Connexion et sécurité › Obtenir un code de validation et saisissez le code à 6 chiffres."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Falls keine Abfrage auf deinem vertrauenswürdigen Gerät erscheint, öffne Einstellungen › Apple Account › Anmeldung & Sicherheit › Bestätigungscode erhalten und gib den 6-stelligen Code ein."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se nenhum aviso aparecer no dispositivo confiável, abra Ajustes › Conta Apple › Início de Sessão e Segurança › Obter Código de Verificação e digite o código de 6 dígitos."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذا لم يظهر تنبيه على جهازك الموثوق، افتح الإعدادات › حساب Apple › تسجيل الدخول والأمن › الحصول على رمز تحقق وأدخل الرمز المكوّن من 6 أرقام."
          }
        }
      }
    },
