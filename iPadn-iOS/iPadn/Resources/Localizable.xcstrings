        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "匯率為 %@ 的參考中間價，實際扣款以髮卡銀行為準。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 時点の参考仲値です。実際の請求額はカード発行会社が決定します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 기준 참고 중간 환율이며, 실제 청구 금액은 카드 발급사가 정합니다."
          }
        }
      }
    },
