        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce fichier risque de ne pas s'installer ou fonctionner correctement ; réessayez ou utilisez un IPA d'origine complet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Ausgabe lässt sich möglicherweise nicht direkt installieren oder starten; erneut versuchen oder vollständige Original-IPA verwenden."
          }
        },
        "pt-BR": {
          "stringUnit": {
