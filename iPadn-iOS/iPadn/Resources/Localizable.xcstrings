    "适用于已配置 Surge、Loon 等代理规则的用户。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For people who already have proxy rules in Surge, Loon and similar tools."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "适用于已配置 Surge、Loon 等代理规则的用户。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "適用於已配置 Surge、Loon 等代理規則的使用者。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Surge、Loon などですでにプロキシルールを設定している方向けです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Surge, Loon 등에서 이미 프록시 규칙을 설정한 사용자용입니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для тех, у кого уже есть правила прокси в Surge, Loon и подобных программах."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para quienes ya tienen reglas de proxy en Surge, Loon y herramientas similares."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour ceux qui ont déjà des règles de proxy dans Surge, Loon et outils similaires."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für alle, die bereits Proxy-Regeln in Surge, Loon und ähnlichen Tools haben."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para quem já tem regras de proxy no Surge, Loon e ferramentas parecidas."
          }
        },
        "ar": {
          "stringUnit": {
