          }
        }
      }
    },
    "当前网络无法连接 Apple 服务，建议暂时关闭 VPN 或代理，或切换为强制直连后重试。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前网络无法连接 Apple 服务，建议暂时关闭 VPN 或代理，或切换为强制直连后重试。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unable to reach Apple services on this network. Try disabling VPN/proxy temporarily or switch to Force Direct and retry."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前網路無法連接 Apple 服務，建議暫時關閉 VPN 或代理，或切換為強制直連後重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このネットワークでは Apple サービスに接続できません。VPN やプロキシを一時的にオフにするか、直接接続に切り替えて再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 네트워크에서 Apple 서비스에 연결할 수 없습니다. VPN이나 프록시를 잠시 끄거나 직접 연결 강제로 전환 후 다시 시도하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удаётся подключиться к сервисам Apple. Отключите VPN/прокси или переключитесь на прямое соединение и повторите попытку."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede conectar con los servicios de Apple. Prueba a desactivar la VPN/proxy o cambia a conexión directa y reintenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de joindre les services Apple. Désactivez temporairement le VPN/proxy ou passez en connexion directe."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple-Dienste sind in diesem Netzwerk nicht erreichbar. Deaktiviere VPN/Proxy vorübergehend oder wechsle auf Direktverbindung."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível conectar aos serviços da Apple. Desative a VPN/proxy ou mude para conexão direta e tente novamente."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر الاتصال بخدمات Apple عبر هذه الشبكة. جرّب إيقاف VPN أو الوكيل مؤقتًا أو التبديل إلى الاتصال المباشر."
          }
        }
      }
    },
    "查看日志": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看日志"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "View Log"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檢視日誌"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログを見る"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그 보기"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показать журнал"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ver registro"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voir le journal"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Protokoll anzeigen"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ver registro"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عرض السجل"
          }
        }
      }
    },
    "检测到代理或 VPN 正在运行，可能会拦截或导致 Apple 登录被拒。建议暂时关闭 VPN，或在代理中将以下 Apple 域名设为直连后重试。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检测到代理或 VPN 正在运行，可能会拦截或导致 Apple 登录被拒。建议暂时关闭 VPN，或在代理中将以下 Apple 域名设为直连后重试。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A proxy or VPN is active and may cause Apple Sign-In to reject the request. Try turning off VPN temporarily or set these Apple domains to DIRECT and retry."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "偵測到代理或 VPN 正在執行，可能會攔截或導致 Apple 登入被拒。建議暫時關閉 VPN，或在代理中將以下 Apple 網域設為直連後重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロキシまたは VPN が有効なため、Apple サインインが拒否される場合があります。VPN を一時的にオフにするか、以下の Apple ドメインを DIRECT に設定して再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프록시 또는 VPN이 활성화되어 Apple 로그인이 거부될 수 있습니다. VPN을 잠시 끄거나 아래 Apple 도메인을 DIRECT로 설정한 후 다시 시도하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Активен прокси или VPN, из-за чего Apple может отклонить вход. Отключите VPN или добавьте указанные домены Apple в DIRECT и повторите попытку."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay un proxy o VPN activo que puede provocar que Apple rechace el inicio de sesión. Desactiva la VPN o configura estos dominios en DIRECT y reintenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un proxy ou VPN est actif et peut entraîner le refus de la connexion Apple. Désactivez le VPN ou mettez ces domaines en DIRECT puis réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Proxy oder VPN ist aktiv und kann die Apple-Anmeldung blockieren. Deaktiviere das VPN vorübergehend oder setze diese Domains auf DIRECT."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um proxy ou VPN está ativo e pode fazer a Apple recusar o login. Desative a VPN ou defina estes domínios como DIRECT e tente novamente."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم اكتشاف وكيل أو VPN نشط قد يتسبب في رفض تسجيل دخول Apple. جرّب إيقاف VPN مؤقتًا أو ضبط النطاقات التالية على DIRECT."
          }
        }
      }
    },
    "Apple 暂时拒绝了本次登录请求。若开启了代理或 VPN 建议先关闭后重试；否则请稍等约 30 分钟后再试，避免连续重试。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 暂时拒绝了本次登录请求。若开启了代理或 VPN 建议先关闭后重试；否则请稍等约 30 分钟后再试，避免连续重试。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple temporarily declined this sign-in request. If a proxy or VPN is on, turn it off and try again; otherwise wait about 30 minutes and avoid repeated attempts."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 暫時拒絕了本次登入要求。若開啟了代理或 VPN 建議先關閉後重試；否則請稍等約 30 分鐘後再試，避免連續重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple がこのサインイン要求を一時的に拒否しました。VPN/プロキシがオンならオフにして再試行し、そうでなければ約 30 分待ってから再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple이 이번 로그인 요청을 일시적으로 거부했습니다. VPN이나 프록시가 켜져 있다면 끄고 다시 시도하고, 아니라면 약 30분 후 다시 시도해 주세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple временно отклонила запрос на вход. Если включён VPN/прокси, отключите его; иначе подождите около 30 минут и не повторяйте попытки подряд."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple rechazó temporalmente esta solicitud. Si usas VPN/proxy, desactívalo y reintenta; de lo contrario, espera unos 30 minutos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple a temporairement refusé cette connexion. Si un VPN/proxy est actif, désactivez-le ; sinon patientez environ 30 minutes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple hat diese Anmeldung vorübergehend abgelehnt. Falls VPN/Proxy aktiv ist, deaktiviere es; warte sonst etwa 30 Minuten."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Apple recusou temporariamente este login. Se uma VPN/proxy estiver ativa, desative-a; caso contrário, aguarde cerca de 30 minutos."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رفضت Apple طلب تسجيل الدخول مؤقتًا. إذا كان VPN أو الوكيل مفعّلًا فأوقفه وجرّب مجددًا؛ وإلا فانتظر نحو 30 دقيقة."
          }
        }
      }
    },
    "Apple 账号或密码验证未通过，请在右上角头像中检查或更新账号后重试。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 账号或密码验证未通过，请在右上角头像中检查或更新账号后重试。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Account credentials were not accepted. Check or update your account via the top-right avatar and try again."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 帳號或密碼驗證未通過，請在右上角頭像中檢查或更新帳號後重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple アカウントまたはパスワードの認証に失敗しました。右上のアイコンからアカウントを確認して再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 계정 또는 비밀번호 인증에 실패했습니다. 오른쪽 상단 아바타에서 계정을 확인한 후 다시 시도하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось проверить аккаунт Apple или пароль. Проверьте данные через аватар в правом верхнем углу и повторите попытку."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se aceptaron las credenciales de Apple. Verifica o actualiza la cuenta en el avatar superior derecho e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Identifiants Apple refusés. Vérifiez ou mettez à jour votre compte via l'avatar en haut à droite puis réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Account oder Passwort nicht akzeptiert. Prüfe die Zugangsdaten über das Profilbild oben rechts und versuche es erneut."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Credenciais da conta Apple não aceitas. Verifique ou atualize sua conta pelo avatar no canto superior direito e tente novamente."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم قبول بيانات حساب Apple. تحقق من الحساب أو حدّثه عبر الصورة الرمزية في الأعلى ثم أعد المحاولة."
          }
        }
      }
    },
    "登录凭据未通过验证，请重新尝试；详细原因已记录在诊断日志中。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录凭据未通过验证，请重新尝试；详细原因已记录在诊断日志中。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign-in credentials could not be verified. Please try again; technical details were saved to the diagnostic log."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "登入憑證未通過驗證，請重新嘗試；詳細原因已記錄在診斷日誌中。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "認証情報を確認できませんでした。再試行してください（詳細は診断ログに記録されています）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인 자격 증명을 확인할 수 없습니다. 다시 시도해 주세요(자세한 내용은 진단 로그에 기록됨)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось подтвердить учётные данные. Повторите попытку; подробности сохранены в журнале диагностики."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron verificar las credenciales. Inténtalo de nuevo; los detalles se guardaron en el registro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de vérifier les identifiants. Réessayez ; les détails sont enregistrés dans le journal."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anmeldedaten konnten nicht überprüft werden. Bitte erneut versuchen; Details stehen im Diagnoseprotokoll."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível verificar as credenciais. Tente novamente; os detalhes foram salvos no registro de diagnóstico."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر التحقق من بيانات تسجيل الدخول. يرجى المحاولة مرة أخرى؛ تم حفظ التفاصيل في سجل التشخيص."
          }
        }
      }
    },
    "连接 Apple 服务时出现异常，可能与当前代理或 VPN 有关。建议关闭 VPN 或设为直连后重试，详情可在日志中查看。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接 Apple 服务时出现异常，可能与当前代理或 VPN 有关。建议关闭 VPN 或设为直连后重试，详情可在日志中查看。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not connect to Apple services. This may be caused by an active proxy or VPN. Try disabling VPN or setting Apple domains to DIRECT; details are in the log."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連接 Apple 服務時出現異常，可能與目前代理或 VPN 有關。建議關閉 VPN 或設為直連後重試，詳情可在日誌中查看。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple サービスへの接続でエラーが発生しました。VPN/プロキシが原因の可能性があります。オフにするか直接接続で再試行してください（詳細はログ参照）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 서비스 연결 중 오류가 발생했습니다. VPN 또는 프록시 영향일 수 있으니 끄거나 직접 연결로 다시 시도해 주세요(자세한 내용은 로그 확인)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ошибка подключения к сервисам Apple — возможно, из-за VPN или прокси. Отключите VPN или выберите прямое соединение; подробности в журнале."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Error al conectar con los servicios de Apple, posiblemente por la VPN o proxy. Desactívalo o usa conexión directa; consulta el registro para más detalles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de se connecter aux services Apple, probablement à cause du VPN ou proxy. Désactivez-le ou passez en direct ; détails dans le journal."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbindung zu Apple-Diensten fehlgeschlagen, möglicherweise wegen VPN oder Proxy. Deaktiviere es oder nutze Direktverbindung; Details im Protokoll."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Erro ao conectar aos serviços da Apple, possivelmente devido à VPN ou proxy. Desative ou use conexão direta; veja detalhes no registro."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حدث خطأ أثناء الاتصال بخدمات Apple، قد يكون بسبب VPN أو الوكيل. جرّب إيقافه أو استخدام الاتصال المباشر؛ التفاصيل في السجل."
          }
        }
      }
    },
    "连接 Apple 登录服务失败，请检查网络后重试；详细错误已记录在诊断日志中。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接 Apple 登录服务失败，请检查网络后重试；详细错误已记录在诊断日志中。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not reach Apple Sign-In. Check your network and try again; technical details were saved to the diagnostic log."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連接 Apple 登入服務失敗，請檢查網路後重試；詳細錯誤已記錄在診斷日誌中。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple サインインに接続できませんでした。ネットワークを確認して再試行してください（詳細は診断ログに記録されています）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 로그인 서비스에 연결하지 못했습니다. 네트워크를 확인한 후 다시 시도해 주세요(자세한 내용은 진단 로그에 기록됨)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось подключиться к службе входа Apple. Проверьте сеть и повторите попытку; подробности в журнале диагностики."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Error al conectar con Apple Sign-In. Comprueba tu red y reintenta; los detalles están en el registro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de joindre Apple Sign-In. Vérifiez votre réseau et réessayez ; les détails sont dans le journal."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple-Anmeldung fehlgeschlagen. Prüfe dein Netzwerk und versuche es erneut; Details stehen im Protokoll."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Falha ao conectar ao login da Apple. Verifique sua rede e tente novamente; detalhes salvos no registro."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر الاتصال بخدمة تسجيل دخول Apple. تحقق من الشبكة وأعد المحاولة؛ تم حفظ التفاصيل في سجل التشخيص."
          }
        }
      }
    },
