          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В App Store нет встроенных покупок для этого приложения."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El App Store no muestra compras dentro de la app para esta app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’App Store ne liste aucun achat intégré pour cette app."
