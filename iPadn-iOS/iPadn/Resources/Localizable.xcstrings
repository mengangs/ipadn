    "包含设置、版本来源、关注与应用记录、最近搜索、Apple 账号会话（Cookie、令牌与密码）及设备商店凭证；不包含已下载的安装包。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "包含设置、版本来源、关注与应用记录、最近搜索、Apple 账号会话（Cookie、令牌与密码）及设备商店凭证；不包含已下载的安装包。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "包含設定、版本來源、關注與 App 記錄、最近搜尋、Apple 帳號工作階段（Cookie、權杖與密碼）及裝置商店憑證；不包含已下載的安裝包。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Includes settings, version sources, followed apps, recent searches, Apple account sessions (cookies, tokens, passwords), and device store proof; downloaded IPAs are excluded."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定、バージョンソース、フォローと履歴、検索履歴、Apple アカウントセッション（Cookie・トークン・パスワード）およびデバイスストア証明が含まれます。ダウンロード済み IPA は含まれません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정, 버전 소스, 팔로우 및 기록, 최근 검색, Apple 계정 세션(Cookie, 토큰, 암호) 및 기기 스토어 증명이 포함됩니다. 다운로드한 IPA는 제외됩니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Enthält Einstellungen, Versionsquellen, gefolgte Apps, Suchverlauf, Apple-Account-Sitzungen (Cookies, Tokens, Passwörter) und Store-Nachweise; geladene IPAs sind ausgeschlossen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Inclut les réglages, sources, suivis, recherches, sessions Apple (cookies, jetons, mots de passe) et justificatifs d’appareil ; les IPA téléchargés sont exclus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Incluye ajustes, fuentes, seguidos, búsquedas, sesiones de Apple (cookies, tokens, contraseñas) y credenciales del dispositivo; excluye los IPA descargados."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Inclui ajustes, fontes, seguidos, buscas, sessões Apple (cookies, tokens, senhas) e credenciais do dispositivo; IPAs baixados ficam excluídos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включает настройки, источники версий, подписки, историю поиска, сессии Apple (cookie, токены, пароли) и данные устройства; загруженные IPA не включаются."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يشمل الإعدادات والمصادر والمتابَعة والبحث وجلسات Apple (ملفات تعريف الارتباط والرموز وكلمات المرور) وبيانات الجهاز؛ لا يشمل ملفات IPA المنزّلة."
          }
        }
      }
    },
