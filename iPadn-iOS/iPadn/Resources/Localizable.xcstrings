            "value": "Os dados do pacote ultrapassam o fim do arquivo; ele pode estar incompleto"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تمتد بيانات الحزمة إلى ما بعد نهاية الملف، وقد يكون غير مكتمل"
          }
        }
      }
    },
    "安装包文件校验失败，文件可能仍被加密或已损坏": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A package file failed its checksum; the file may still be encrypted or damaged"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安装包文件校验失败，文件可能仍被加密或已损坏"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "安裝包檔案校驗失敗，檔案可能仍被加密或已損壞"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パッケージ内のファイルのチェックサム検証に失敗しました。ファイルが暗号化されたままか破損している可能性があります"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "패키지 파일의 체크섬 확인에 실패했습니다. 파일이 아직 암호화되어 있거나 손상되었을 수 있습니다"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл в пакете не прошел проверку контрольной суммы; возможно, он еще зашифрован или поврежден"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un archivo del paquete no superó la suma de verificación; puede seguir cifrado o estar dañado"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un fichier du paquet a échoué au contrôle ; il est peut-être encore chiffré ou endommagé"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Paketdatei hat die Prüfsumme nicht bestanden; sie ist eventuell noch verschlüsselt oder beschädigt"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um arquivo do pacote falhou na soma de verificação; pode ainda estar criptografado ou danificado"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فشل ملف في الحزمة في التحقق من المجموع؛ قد يكون لا يزال مشفّرًا أو تالفًا"
          }
        }
      }
    },
    "安装包文件缺少可验证的校验值": {
