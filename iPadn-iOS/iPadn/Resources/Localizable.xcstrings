    },
    "设备标识需要是 12 位十六进制字符（0–9、A–F）": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The device identifier must be 12 hex characters (0–9, A–F)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备标识需要是 12 位十六进制字符（0–9、A–F）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "裝置標識需要是 12 位十六進位制字元（0–9、A–F）"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイス識別子は 16 進数 12 文字（0–9、A–F）である必要があります"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기 식별자는 16진수 12자(0–9, A–F)여야 합니다"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Идентификатор устройства должен состоять из 12 шестнадцатеричных символов (0–9, A–F)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El identificador del dispositivo debe tener 12 caracteres hexadecimales (0–9, A–F)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’identifiant de l’appareil doit comporter 12 caractères hexadécimaux (0–9, A–F)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Gerätekennung muss aus 12 Hexadezimalzeichen bestehen (0–9, A–F)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O identificador do dispositivo deve ter 12 caracteres hexadecimais (0–9, A–F)"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب أن يتكون معرّف الجهاز من 12 حرفًا ست عشريًا (0–9، A–F)"
