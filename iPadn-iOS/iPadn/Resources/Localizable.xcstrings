    "请在系统弹窗中确认安装，完成前请勿退出 iPadn。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm the installation in the system prompt. Don't leave iPadn until it finishes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在系统弹窗中确认安装，完成前请勿退出 iPadn。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在系統彈窗中確認安裝，完成前請勿退出 iPadn。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムの画面でインストールを確認してください。完了するまで iPadn を終了しないでください。"
          }
        },
        "ko": {
          "stringUnit": {
