    "重新尝试后台下载": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新尝试后台下载"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try Background Downloads Again"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重新嘗試後臺下載"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックグラウンドダウンロードを再試行"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백그라운드 다운로드 다시 시도"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Снова попробовать фоновую загрузку"
          }
        },
        "es": {
          "stringUnit": {
