        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 결과물은 바로 설치하거나 실행하지 못할 수 있습니다. 다시 시도하거나 온전한 원본 IPA를 사용하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот файл может не установиться или не запуститься. Повторите попытку или используйте целый исходный IPA."
