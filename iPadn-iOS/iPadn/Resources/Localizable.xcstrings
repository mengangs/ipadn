    "未能获取免费应用许可，请先在 App Store 获取后重试": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't get the free app's license. Get it in the App Store first."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未能获取免费应用许可，请先在 App Store 获取后重试"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未能取得免費應用許可，請先在 App Store 取得後重試"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無料 App のライセンスを取得できませんでした。先に App Store で入手してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무료 앱의 라이선스를 받을 수 없습니다. 먼저 App Store에서 받으십시오."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось получить лицензию на бесплатное приложение. Сначала получите его в App Store."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo obtener la licencia de la app gratuita. Obtenla primero en el App Store."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’obtenir la licence de l’app gratuite. Obtenez-la d’abord sur l’App Store."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lizenz für die kostenlose App konnte nicht abgerufen werden. Lade sie zuerst im App Store."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível obter a licença do app gratuito. Obtenha-o primeiro na App Store."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر الحصول على ترخيص التطبيق المجاني. احصل عليه من App Store أولًا."
          }
        }
      }
    },
