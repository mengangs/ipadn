          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Settings › Privacy & Security › Developer Mode and tap “Pair with iPadn”."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請開啟「設定 › 隱私權與安全性 › 開發者模式」，點一下「與 iPadn 配對」。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「設定 › プライバシーとセキュリティ › デベロッパモード」を開き、「iPadn とペアリング」をタップしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘설정 › 개인정보 보호 및 보안 › 개발자 모드’를 열고 ‘iPadn과 페어링’을 탭하십시오."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте Настройки › Конфиденциальность и безопасность › Режим разработчика и коснитесь «Pair with iPadn»."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Ajustes › Privacidad y seguridad › Modo de desarrollador y toca «Pair with iPadn»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez Réglages › Confidentialité et sécurité › Mode développeur et touchez « Pair with iPadn »."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne Einstellungen › Datenschutz & Sicherheit › Entwicklermodus und tippe auf „Pair with iPadn“."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
