          }
        }
      }
    },
    "这次产物可能无法直接安装使用；重试，或换一个完整的原始 IPA。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这次产物可能无法直接安装使用；重试，或换一个完整的原始 IPA。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This output may not install or launch properly. Retry or use a complete original IPA."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這次產物可能無法直接安裝使用；重試，或換一個完整的原始 IPA。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
