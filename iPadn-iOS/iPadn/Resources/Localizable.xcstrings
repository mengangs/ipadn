            "value": "Цены в США и Канаде указаны без налога с продаж."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los precios en EE. UU. y Canadá no incluyen impuestos sobre las ventas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les prix aux États-Unis et au Canada sont hors taxes de vente."
          }
        },
        "de": {
