            "value": "暂时无法检查商店状态，请稍后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "暫時無法檢查商店狀態，請稍後重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在ストアの状況を確認できません。しばらくしてからもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금은 스토어 상태를 확인할 수 없습니다. 나중에 다시 시도하십시오."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сейчас нельзя проверить статус в магазине. Повторите попытку позже."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora no se puede comprobar el estado en la tienda. Inténtalo más tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de vérifier l’état sur le Store pour le moment. Réessayez plus tard."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Store-Status kann gerade nicht geprüft werden. Versuche es später erneut."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível verificar o status na loja agora. Tente mais tarde."
          }
