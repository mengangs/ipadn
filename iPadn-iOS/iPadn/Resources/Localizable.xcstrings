    "关注后会记录价格变化，降价或限免时提醒你。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Following records price changes and notifies you about price drops or free promotions."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关注后会记录价格变化，降价或限免时提醒你。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關注後會記錄價格變化，降價或限免時提醒你。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォローすると価格の変動を記録し、値下げや無料化を通知します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "팔로우하면 가격 변동을 기록하고 가격 인하나 무료 전환을 알려 줍니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При отслеживании записываются изменения цены и приходят уведомления о снижении цены или бесплатных акциях."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al seguir una app se registran los cambios de precio y se te avisa de bajadas o promociones gratuitas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le suivi enregistre les changements de prix et vous avertit des baisses de prix ou des promotions gratuites."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Folgen werden Preisänderungen erfasst und du wirst über Preissenkungen oder Gratisaktionen informiert."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao seguir, as mudanças de preço são registradas e você é avisado sobre quedas ou promoções gratuitas."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تسجّل المتابعة تغييرات السعر وتُعلمك بانخفاض السعر أو العروض المجانية."
          }
        }
      }
    },
