    "本地验证环境加载超时，请重试。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The local verification runtime timed out. Try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地验证环境加载超时，请重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本地驗證環境載入超時，請重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルの確認用ランタイムがタイムアウトしました。もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로컬 확인용 런타임의 시간이 초과되었습니다. 다시 시도하십시오."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Истекло время ожидания локальной среды проверки. Повторите попытку."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se agotó el tiempo del entorno de verificación local. Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’environnement de vérification local a expiré. Réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die lokale Prüfumgebung hat das Zeitlimit überschritten. Versuche es erneut."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O ambiente de verificação local excedeu o tempo. Tente de novo."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهت مهلة بيئة التحقق المحلية. حاول مرة أخرى."
          }
        }
      }
    },
