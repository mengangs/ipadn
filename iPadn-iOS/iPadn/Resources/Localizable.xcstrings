    "关注 App ID 或 App Store 链接对应的应用；有新版本、降价或限免时提醒你。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关注 App ID 或 App Store 链接对应的应用；有新版本、降价或限免时提醒你。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Follows the app for an App ID or App Store link and tells you about new versions, price drops and free offers."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關注 App ID 或 App Store 連結對應的 App；有新版本、降價或限免時提醒你。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "App IDまたはApp Storeリンクに対応するAppをフォローし、新バージョン、値下げ、無料化を通知します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "App ID 또는 App Store 링크에 해당하는 앱을 팔로우하고 새 버전, 가격 인하, 무료 전환을 알려 줍니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Следит за приложением по App ID или ссылке App Store и сообщает о новых версиях, снижении цены и бесплатных предложениях."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigue la app de un App ID o enlace de App Store y te avisa de versiones nuevas, bajadas de precio y ofertas gratuitas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suit l’app d’un App ID ou d’un lien App Store et vous prévient des nouvelles versions, baisses de prix et offres gratuites."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Folgt der App zu einer App-ID oder einem App Store-Link und meldet neue Versionen, Preissenkungen und Gratisangebote."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Segue o app de um App ID ou link da App Store e avisa sobre versões novas, quedas de preço e ofertas grátis."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتابع التطبيق المطابق لـ App ID أو رابط App Store وينبهك إلى الإصدارات الجديدة وتخفيضات الأسعار والعروض المجانية."
          }
        }
      }
    },
