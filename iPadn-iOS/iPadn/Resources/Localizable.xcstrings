    "说明文字由开发者填写，申请时系统会显示给你。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "说明文字由开发者填写，申请时系统会显示给你。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The reasons are written by the developer; the system shows them when the app asks."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "說明文字由開發者填寫，申請時系統會顯示給你。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "理由は開発者が記入したもので、App が許可を求めるときにシステムが表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사유는 개발자가 작성하며, 앱이 요청할 때 시스템이 보여 줍니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пояснения пишет разработчик; система показывает их при запросе."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El desarrollador escribe los motivos; el sistema los muestra cuando la app los pide."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les raisons sont rédigées par le développeur ; le système les affiche lors de la demande."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Gründe schreibt der Entwickler; das System zeigt sie bei der Anfrage."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os motivos são escritos pelo desenvolvedor; o sistema os mostra quando o app pede."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يكتب المطوّر الأسباب، ويعرضها النظام عند الطلب."
          }
        }
      }
    },
