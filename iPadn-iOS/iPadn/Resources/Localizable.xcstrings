    "需先在安装方式中创建证书、安装描述文件并开启信任。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create a certificate in Install method first, then install the profile and enable trust."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需先在安装方式中创建证书、安装描述文件并开启信任。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "需先在安裝方式中建立憑證、安裝描述檔並開啟信任。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "先に「インストール方法」で証明書を作成し、プロファイルをインストールして信頼をオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 설치 방법에서 인증서를 만든 후 프로파일을 설치하고 신뢰를 켜십시오."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала создайте сертификат в разделе «Способ установки», затем установите профиль и включите доверие."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primero crea un certificado en Método de instalación y luego instala el perfil y activa la confianza."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Créez d’abord un certificat dans Méthode d’installation, puis installez le profil et activez la confiance."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstelle zuerst unter „Installationsmethode“ ein Zertifikat, installiere dann das Profil und aktiviere das Vertrauen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Primeiro crie um certificado em Método de instalação, depois instale o perfil e ative a confiança."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنشئ شهادة أولًا في طريقة التثبيت، ثم ثبّت ملف التعريف وفعّل الثقة."
          }
        }
      }
    },
    "需要已配置的代理规则。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Requires proxy rules you've already set up."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要已配置的代理规则。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "需要已配置的代理規則。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定済みのプロキシルールが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미 설정한 프록시 규칙이 필요합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Требуются уже настроенные правила прокси."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Requiere reglas de proxy que ya hayas configurado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nécessite des règles de proxy déjà configurées."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfordert bereits eingerichtete Proxy-Regeln."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Requer regras de proxy já configuradas."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتطلب قواعد وكيل أعددتها مسبقًا."
          }
        }
      }
    },
    "需要重新安装并信任新的描述文件。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You'll need to install and trust the new profile."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要重新安装并信任新的描述文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "需要重新安裝並信任新的描述檔。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいプロファイルをインストールして信頼する必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 프로파일을 설치하고 신뢰해야 합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Потребуется установить новый профиль и довериться ему."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendrás que instalar el nuevo perfil y confiar en él."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous devrez installer et approuver le nouveau profil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du musst das neue Profil installieren und ihm vertrauen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Será preciso instalar e confiar no novo perfil."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستحتاج إلى تثبيت ملف التعريف الجديد والوثوق به."
          }
        }
      }
    },
