    "账号仍会保留，可随时切换回来。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The account is kept; you can switch back at any time."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "账号仍会保留，可随时切换回来。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "帳號仍會保留，可隨時切換回來。"
          }
        },
        "ja": {
