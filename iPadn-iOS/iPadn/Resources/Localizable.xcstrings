          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر تحضير اللغات: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "语言包准备失败：%@"
          }
        }
      }
    },
    "默认使用系统翻译面板。开启后，点击翻译会直接替换正文，并可显示原文。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The system translation sheet is used by default. Enable this to replace text with a translation directly, with an option to show the original."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預設使用系統翻譯面板。開啟後，點按翻譯會直接替換內文，並可顯示原文。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "標準ではシステムの翻訳シートを使用します。有効にすると翻訳で本文を直接置き換え、原文に戻すこともできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본적으로 시스템 번역 시트를 사용합니다. 켜면 번역문으로 본문을 바로 바꾸고 원문을 다시 볼 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По умолчанию используется системная панель перевода. Включите этот режим, чтобы заменять текст переводом с возможностью показать оригинал."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se usa el panel de traducción del sistema de forma predeterminada. Activa esta opción para sustituir el texto por su traducción y poder mostrar el original."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le panneau de traduction du système est utilisé par défaut. Activez cette option pour remplacer directement le texte par sa traduction et pouvoir afficher l’original."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standardmäßig wird das Übersetzungsfenster des Systems verwendet. Aktivieren, um Text direkt durch die Übersetzung zu ersetzen und bei Bedarf das Original anzuzeigen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Por padrão, é usado o painel de tradução do sistema. Ative para substituir o texto diretamente pela tradução, com a opção de mostrar o original."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُستخدم لوحة ترجمة النظام افتراضيًا. فعّل هذا الخيار لاستبدال النص مباشرة بالترجمة مع إمكانية عرض الأصل."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认使用系统翻译面板。开启后，点击翻译会直接替换正文，并可显示原文。"
          }
        }
      }
    },
    "直接替换翻译需要 iOS 18 或更高版本。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In-place translation requires iOS 18 or later."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "直接替換翻譯需要 iOS 18 或更新版本。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "直接置き換える翻訳には iOS 18 以降が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "바로 바꾸기 번역에는 iOS 18 이상이 필요합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевод в тексте требует iOS 18 или новее."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La traducción en el texto requiere iOS 18 o posterior."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La traduction dans le texte nécessite iOS 18 ou une version ultérieure."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die direkte Übersetzung erfordert iOS 18 oder neuer."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A tradução no texto requer iOS 18 ou posterior."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتطلب الترجمة داخل النص iOS 18 أو أحدث."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "直接替换翻译需要 iOS 18 或更高版本。"
          }
        }
      }
    },
    "译文使用 iPadn 的界面语言。选择需要翻译的原文语言，再准备语言包；其他语言首次使用时仍可能需要下载。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Translations use the iPadn interface language. Choose a source language, then prepare its languages. Other source languages may still need a download on first use."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "譯文使用 iPadn 的介面語言。選擇需要翻譯的原文語言，再準備語言套件；其他語言首次使用時仍可能需要下載。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "翻訳先は iPadn の表示言語です。原文の言語を選び、言語を準備してください。他の言語は初回使用時にダウンロードが必要な場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPadn의 인터페이스 언어로 번역합니다. 원문 언어를 선택한 다음 언어를 준비하세요. 다른 언어는 처음 사용할 때 다운로드가 필요할 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевод выполняется на язык интерфейса iPadn. Выберите исходный язык и подготовьте языки. Другим языкам при первом использовании может потребоваться загрузка."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se traduce al idioma de la interfaz de iPadn. Elige el idioma de origen y prepara los idiomas. Otros idiomas pueden requerir una descarga al usarlos por primera vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La traduction utilise la langue de l’interface d’iPadn. Choisissez la langue source, puis préparez les langues. D’autres langues peuvent nécessiter un téléchargement à la première utilisation."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Übersetzung erfolgt in die Oberflächensprache von iPadn. Ausgangssprache wählen und die Sprachen vorbereiten. Andere Sprachen benötigen bei der ersten Nutzung möglicherweise einen Download."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As traduções usam o idioma da interface do iPadn. Escolha o idioma de origem e prepare os idiomas. Outros idiomas ainda podem exigir um download no primeiro uso."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تستخدم الترجمات لغة واجهة iPadn. اختر لغة المصدر ثم حضّر اللغات. قد يلزم تنزيل لغات أخرى عند استخدامها لأول مرة."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "译文使用 iPadn 的界面语言。选择需要翻译的原文语言，再准备语言包；其他语言首次使用时仍可能需要下载。"
          }
        }
      }
    },
