            "value": "No apps to show"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有可顯示的 App"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "表示できる App はありません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "표시할 앱이 없습니다"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет приложений для показа"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay apps que mostrar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune app à afficher"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Apps anzuzeigen"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum app para mostrar"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد تطبيقات لعرضها"
          }
        }
      }
    },
    "这些应用是通过网页安装的，App Store 显示云朵、无法更新。用原生安装重新安装一次即可恢复，数据会保留。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些应用是通过网页安装的，App Store 显示云朵、无法更新。用原生安装重新安装一次即可恢复，数据会保留。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These were installed from a link, so the App Store shows a cloud and can’t update them. Install once more with Native Install to fix it; data is kept."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這些 App 是透過網頁安裝的，App Store 顯示雲朵、無法更新。用原生安裝重新安裝一次即可回復，資料會保留。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらはリンクからインストールされたため、App Store では雲のアイコンが表示され、アップデートできません。ネイティブインストールでもう一度インストールすると直ります。データは保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "링크로 설치된 앱이라 App Store에 구름 아이콘이 표시되고 업데이트할 수 없습니다. 네이티브 설치로 한 번 더 설치하면 해결되며 데이터는 유지됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эти приложения установлены по ссылке, поэтому App Store показывает облако и не обновляет их. Установите их еще раз нативной установкой — данные сохранятся."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se instalaron desde un enlace, así que el App Store muestra una nube y no puede actualizarlas. Vuelve a instalarlas con la instalación nativa para arreglarlo; los datos se conservan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elles ont été installées depuis un lien : l’App Store affiche un nuage et ne peut pas les mettre à jour. Réinstallez-les avec l’installation native pour corriger cela ; les données sont conservées."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese wurden über einen Link installiert, daher zeigt der App Store eine Wolke und kann sie nicht aktualisieren. Installiere sie noch einmal per nativer Installation; die Daten bleiben erhalten."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Foram instalados por um link, então a App Store mostra uma nuvem e não consegue atualizá-los. Instale de novo com a instalação nativa para resolver; os dados são mantidos."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ثُبّتت هذه التطبيقات من رابط، لذا يعرض App Store سحابة ولا يمكنه تحديثها. ثبّتها مرة أخرى بالتثبيت الأصلي لإصلاح ذلك مع الاحتفاظ بالبيانات."
          }
        }
      }
    },
    "用其他签名工具安装的应用，App Store 无法更新。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用其他签名工具安装的应用，App Store 无法更新。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps installed with other signing tools. The App Store can’t update them."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用其他簽名工具安裝的 App，App Store 無法更新。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "他の署名ツールでインストールされた App です。App Store ではアップデートできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 서명 도구로 설치된 앱입니다. App Store에서 업데이트할 수 없습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Установлены другими инструментами подписи. App Store не может их обновить."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps instaladas con otras herramientas de firma. El App Store no puede actualizarlas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps installées avec d’autres outils de signature. L’App Store ne peut pas les mettre à jour."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit anderen Signierwerkzeugen installierte Apps. Der App Store kann sie nicht aktualisieren."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps instalados com outras ferramentas de assinatura. A App Store não consegue atualizá-los."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تطبيقات مثبّتة بأدوات توقيع أخرى. لا يمكن لـ App Store تحديثها."
          }
        }
      }
    },
    "已装应用列表只在本机读取。检查更新时会向 Apple 查询这些应用的商店版本。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已装应用列表只在本机读取。检查更新时会向 Apple 查询这些应用的商店版本。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The list of installed apps is read on this device only. To check for updates, iPadn asks Apple for these apps’ store versions."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已安裝 App 列表只在本機讀取。檢查更新時會向 Apple 查詢這些 App 的商店版本。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インストール済み App の一覧はこのデバイス上でのみ読み込みます。アップデートの確認時に、これらの App のストアのバージョンを Apple に問い合わせます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설치된 앱 목록은 이 기기에서만 읽습니다. 업데이트를 확인할 때 이 앱들의 스토어 버전을 Apple에 조회합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Список установленных приложений читается только на этом устройстве. Для проверки обновлений iPadn запрашивает у Apple версии этих приложений в магазине."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La lista de apps instaladas solo se lee en este dispositivo. Para buscar actualizaciones, iPadn consulta a Apple las versiones de estas apps en la tienda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La liste des apps installées est lue uniquement sur cet appareil. Pour rechercher les mises à jour, iPadn demande à Apple les versions de ces apps sur le Store."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Liste der installierten Apps wird nur auf diesem Gerät gelesen. Für die Update-Prüfung fragt iPadn bei Apple die Store-Versionen dieser Apps ab."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A lista de apps instalados é lida apenas neste dispositivo. Para verificar atualizações, o iPadn consulta na Apple as versões desses apps na loja."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُقرأ قائمة التطبيقات المثبّتة على هذا الجهاز فقط. للتحقق من التحديثات، يسأل iPadn شركة Apple عن إصدارات هذه التطبيقات في المتجر."
          }
        }
      }
    },
    "需要先完成原生安装配对": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要先完成原生安装配对"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pair for Native Install First"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "需要先完成原生安裝配對"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "先にネイティブインストールのペアリングが必要です"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 네이티브 설치 페어링이 필요합니다"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала создайте пару для нативной установки"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primero empareja para la instalación nativa"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jumelez d’abord pour l’installation native"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zuerst für die native Installation koppeln"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Primeiro emparelhe para a instalação nativa"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أكمل إقران التثبيت الأصلي أولًا"
          }
        }
      }
    },
    "本机应用借助原生安装读取手机上已装的应用。在安装设置中完成一次配对后即可使用。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本机应用借助原生安装读取手机上已装的应用。在安装设置中完成一次配对后即可使用。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps on This Device reads the apps installed on this phone through Native Install. Pair once in Installation settings to use it."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本機 App 藉由原生安裝讀取手機上已安裝的 App。在安裝設定中完成一次配對後即可使用。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスの App は、ネイティブインストールを使ってインストール済みの App を読み込みます。インストール設定で一度ペアリングすると使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기의 앱은 네이티브 설치를 통해 설치된 앱을 읽습니다. 설치 설정에서 한 번 페어링하면 사용할 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Раздел читает установленные приложения через нативную установку. Создайте пару один раз в настройках установки."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta sección lee las apps instaladas mediante la instalación nativa. Empareja una vez en los ajustes de instalación para usarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette section lit les apps installées via l’installation native. Jumelez une fois dans les réglages d’installation pour l’utiliser."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Bereich liest die installierten Apps über die native Installation. Kopple einmal in den Installationseinstellungen, um ihn zu nutzen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta seção lê os apps instalados pela instalação nativa. Emparelhe uma vez nos ajustes de instalação para usá-la."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقرأ هذا القسم التطبيقات المثبّتة عبر التثبيت الأصلي. أكمل الإقران مرة واحدة في إعدادات التثبيت لاستخدامه."
          }
        }
      }
    },
    "需要连接 LocalDevVPN": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要连接 LocalDevVPN"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect LocalDevVPN"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "需要連線 LocalDevVPN"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "LocalDevVPN に接続してください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "LocalDevVPN에 연결하세요"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключите LocalDevVPN"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecta LocalDevVPN"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez LocalDevVPN"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "LocalDevVPN verbinden"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecte o LocalDevVPN"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اتصل بـ LocalDevVPN"
          }
        }
      }
    },
    "本机应用通过 LocalDevVPN 读取手机上已装的应用。打开 LocalDevVPN 并点按连接，回到 iPadn 后会自动读取。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本机应用通过 LocalDevVPN 读取手机上已装的应用。打开 LocalDevVPN 并点按连接，回到 iPadn 后会自动读取。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps on This Device reads installed apps through LocalDevVPN. Open LocalDevVPN and tap Connect; iPadn reads the list when you come back."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本機 App 透過 LocalDevVPN 讀取手機上已安裝的 App。打開 LocalDevVPN 並點一下連線，回到 iPadn 後會自動讀取。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスの App は LocalDevVPN を通じてインストール済みの App を読み込みます。LocalDevVPN を開いて接続をタップし、iPadn に戻ると自動で読み込みます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기의 앱은 LocalDevVPN을 통해 설치된 앱을 읽습니다. LocalDevVPN을 열고 연결을 탭한 뒤 iPadn으로 돌아오면 자동으로 읽습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Раздел читает установленные приложения через LocalDevVPN. Откройте LocalDevVPN и нажмите «Подключить» — при возвращении iPadn прочитает список."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta sección lee las apps instaladas a través de LocalDevVPN. Abre LocalDevVPN y toca Conectar; al volver, iPadn leerá la lista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette section lit les apps installées via LocalDevVPN. Ouvrez LocalDevVPN et touchez Connecter ; iPadn lira la liste à votre retour."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Bereich liest installierte Apps über LocalDevVPN. Öffne LocalDevVPN und tippe auf „Verbinden“; beim Zurückkehren liest iPadn die Liste."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta seção lê os apps instalados pelo LocalDevVPN. Abra o LocalDevVPN e toque em Conectar; ao voltar, o iPadn lê a lista."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقرأ هذا القسم التطبيقات المثبّتة عبر LocalDevVPN. افتح LocalDevVPN واضغط «اتصال»، وسيقرأ iPadn القائمة عند عودتك."
          }
        }
      }
    },
