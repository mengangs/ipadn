            "state": "translated",
            "value": "يتعذّر التحقق من حالة المتجر الآن. حاول لاحقًا."
          }
        }
      }
    },
    "暂时无法检查更新，请稍后重试。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can't check for updates right now. Try again later."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
