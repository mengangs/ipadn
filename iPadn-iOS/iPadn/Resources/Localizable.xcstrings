          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在受信任设备上允许登录，然后输入收到的 6 位验证码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
