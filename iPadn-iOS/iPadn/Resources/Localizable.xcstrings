    "点按切换下载账号，侧滑移除。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap to switch the download account; swipe to remove."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按切换下载账号，侧滑移除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點一下切換下載帳號，側滑移除。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タップでダウンロード用アカウントを切り替え、スワイプで削除します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "탭하여 다운로드 계정을 전환하고, 쓸어서 제거합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Коснитесь, чтобы сменить учетную запись для загрузки; смахните, чтобы удалить."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca para cambiar la cuenta de descarga; desliza para eliminarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez pour changer de compte de téléchargement ; balayez pour le supprimer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe, um den Download-Account zu wechseln; wische zum Entfernen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque para trocar a conta de download; deslize para remover."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط لتبديل حساب التنزيل؛ اسحب للإزالة."
          }
        }
      }
