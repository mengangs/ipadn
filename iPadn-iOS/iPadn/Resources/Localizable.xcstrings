            "value": "L’installation native nécessite iOS 17.4 ou version ultérieure"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die native Installation erfordert iOS 17.4 oder neuer"
          }
        },
        "pt-BR": {
          "stringUnit": {
