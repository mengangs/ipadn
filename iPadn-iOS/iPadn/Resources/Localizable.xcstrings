    "搜索、下载和管理你拥有许可的应用安装包，支持 iPhone、iPad、Apple TV 与 Mac。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search, download and manage packages for apps you're licensed to use, on iPhone, iPad, Apple TV and Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "搜索、下载和管理你拥有许可的应用安装包，支持 iPhone、iPad、Apple TV 与 Mac。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "搜尋、下載和管理你擁有許可的應用安裝包，支援 iPhone、iPad、Apple TV 與 Mac。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライセンスを持つ App のパッケージを、iPhone、iPad、Apple TV、Mac 向けに検索、ダウンロード、管理します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "라이선스가 있는 앱의 패키지를 iPhone, iPad, Apple TV, Mac용으로 검색, 다운로드 및 관리합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поиск, загрузка и управление пакетами приложений по вашей лицензии на iPhone, iPad, Apple TV и Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Busca, descarga y gestiona paquetes de apps con licencia para iPhone, iPad, Apple TV y Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recherchez, téléchargez et gérez les paquets des apps sous licence pour iPhone, iPad, Apple TV et Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Suche, lade und verwalte Pakete lizenzierter Apps für iPhone, iPad, Apple TV und Mac."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Busque, baixe e gerencie pacotes de apps licenciados para iPhone, iPad, Apple TV e Mac."
