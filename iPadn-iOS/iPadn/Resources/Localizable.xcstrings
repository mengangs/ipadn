          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiffre toute la sauvegarde avec AES-256-GCM. Ce mot de passe sera demandé lors de l’importation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cifra toda la copia con AES-256-GCM. Se pedirá esta contraseña al importarla."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Criptografa todo o backup com AES-256-GCM. Esta senha será exigida na importação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Шифрует всю резервную копию с помощью AES-256-GCM. Этот пароль потребуется при импорте."
          }
        },
        "ar": {
          "stringUnit": {
