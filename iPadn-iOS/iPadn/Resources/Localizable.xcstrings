          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La requête réseau a échoué (%lld). Réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Netzwerkanfrage fehlgeschlagen (%lld). Versuche es erneut."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A solicitação de rede falhou (%lld). Tente de novo."
          }
