    "本地验证环境加载超时，请重试。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The local verification runtime timed out. Try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地验证环境加载超时，请重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
