        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在「設定」中輸入下面的配對碼"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "下のコードを「設定」に入力"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아래 코드를 ‘설정’에 입력하십시오"
          }
        }
      }
    },
    "回到 %@ 继续安装": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "回到 %@ 继续安装"
          }
        },
