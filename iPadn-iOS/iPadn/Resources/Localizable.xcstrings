    "移除配对文件": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移除配对文件"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove Pairing File"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "移除配對檔案"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペアリングファイルを削除"
