    "关注后会记录价格变化，降价或限免时提醒你。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Following records price changes and notifies you about price drops or free promotions."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关注后会记录价格变化，降价或限免时提醒你。"
