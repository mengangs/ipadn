          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 설치 단계에 진입했습니다. 완료될 때까지 취소할 수 없습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Идёт системная установка. Дождитесь завершения — на этом этапе отмена недоступна."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En fase de instalación del sistema. Espera a que finalice; no se puede cancelar ahora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase d'installation système en cours. Veuillez patienter, l'annulation est impossible."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Systeminstallation läuft. Bitte auf Abschluss warten; jetzt nicht abbrechbar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Na etapa de instalação do sistema. Aguarde a conclusão; não é possível cancelar agora."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بدأت مرحلة تثبيت النظام. يرجى انتظار الاكتمال، ولا يمكن الإلغاء خلالها."
          }
        }
      }
    },
