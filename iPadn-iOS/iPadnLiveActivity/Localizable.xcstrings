          "stringUnit": {
            "state": "translated",
            "value": "Device connected, creating the code"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "裝置已連線，正在生成配對碼"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスが接続されました。コードを作成中"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기가 연결됨, 코드 생성 중"
          }
        }
      }
    },
    "在「设置」中输入下面的配对码": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在「设置」中输入下面的配对码"
          }
        },
