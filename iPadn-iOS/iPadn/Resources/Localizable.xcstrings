            "value": "이 기기에 이미 있는 계정 %lld개 발견"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Найдено существующих аккаунтов: %lld"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se encontraron %lld cuentas existentes"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld comptes déjà présents sur cet appareil"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld bereits vorhandene Accounts gefunden"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld contas já existentes neste dispositivo"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم العثور على %lld حساب موجود مسبقاً"
          }
        }
      }
    },
    "本操作绝不会清除或覆盖本机已登录账号的密码、令牌或会话状态。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本操作绝不会清除或覆盖本机已登录账号的密码、令牌或会话状态。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This never clears or overwrites saved passwords, tokens, or active sessions on existing accounts."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此操作絕不會清除或覆寫本機已登入帳號的密碼、權杖或工作階段狀態。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この操作により、保存済みのパスワード、トークン、有効なセッションが消去または上書きされることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 작업은 기기에 저장된 기존 계정의 비밀번호, 토큰 또는 로그인 세션을 절대 삭제하거나 덮어쓰지 않습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта операция никогда не удаляет и не перезаписывает пароли, токены или активные сессии существующих аккаунтов."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta acción nunca borra ni sobrescribe contraseñas, tokens ni sesiones activas existentes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette opération n’efface ni n’écrase jamais les mots de passe, jetons ou sessions des comptes existants."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dabei werden gespeicherte Passwörter, Tokens oder aktive Sitzungen bestehender Accounts niemals überschrieben."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta ação nunca apaga ou sobrescreve senhas, tokens ou sessões ativas existentes."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لن يؤدي هذا الإجراء أبداً إلى مسح أو استبدال كلمات المرور أو الرموز أو الجلسات النشطة الحالية."
          }
        }
      }
    },
