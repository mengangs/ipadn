    "只删除所选产物和未关联文件，原始 IPA 和处理记录保留。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只删除所选产物和未关联文件，原始 IPA 和处理记录保留。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only selected outputs and unlinked files are removed. Original IPAs and history stay kept."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只刪除所選產物和未關聯文件，原始 IPA 和處理記錄保留。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した出力と未関連ファイルのみ削除します。元の IPA と処理記録は保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 결과물과 연결되지 않은 파일만 삭제됩니다. 원본 IPA와 기록은 보존됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удаляются только выбранные результаты и несвязанные файлы. Исходные IPA и история сохраняются."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se eliminarán los resultados y archivos sin vincular seleccionados. Se conservan los originales y el historial."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuls les résultats et fichiers non associés sélectionnés seront supprimés. Les originaux et l’historique sont conservés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur ausgewählte Ergebnisse und nicht verknüpfte Dateien werden gelöscht. Originale und Verlauf bleiben erhalten."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Somente os resultados e arquivos não vinculados selecionados serão removidos. Os originais e o histórico serão mantidos."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحذف فقط النواتج والملفات غير المرتبطة المحددة. يُحتفظ بالأصل وسجل المعالجة."
          }
        }
      }
    },
    "将删除所选原始 IPA 及对应下载任务，解密产物和处理记录保留。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将删除所选原始 IPA 及对应下载任务，解密产物和处理记录保留。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Selected original IPAs and matching download tasks are removed. Outputs and history stay kept."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將刪除所選原始 IPA 及對應下載任務，解密產物和處理記錄保留。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した元の IPA と対応するダウンロード項目を削除します。復号済み出力と処理記録は保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 원본 IPA와 연결된 다운로드 항목이 삭제됩니다. 복호화 결과와 기록은 보존됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбранные исходные IPA и соответствующие загрузки удаляются. Результаты расшифровки и история сохраняются."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminarán los IPA originales y descargas correspondientes seleccionadas. Los resultados descifrados y el historial se conservan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les IPA d’origine sélectionnés et les téléchargements associés seront supprimés. Les résultats déchiffrés et l’historique sont conservés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausgewählte Original-IPAs und zugehörige Downloads werden entfernt. Entschlüsselte Ergebnisse und Verlauf bleiben erhalten."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os IPAs originais e downloads correspondentes selecionados serão removidos. Os resultados e o histórico serão mantidos."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحذف ملفات IPA الأصلية والتنزيلات المرتبطة المحددة. تُحفظ النواتج المفككة وسجلات المعالجة."
          }
        }
      }
    },
