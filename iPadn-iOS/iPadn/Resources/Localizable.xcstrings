    "Apple 暂时无法完成登录，请稍后重试。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple couldn't complete sign-in. Try again later."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 暂时无法完成登录，请稍后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 暫時無法完成登入，請稍後重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple でサインインを完了できませんでした。しばらくしてからもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple이 로그인을 완료하지 못했습니다. 나중에 다시 시도하십시오."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple не удалось выполнить вход. Повторите попытку позже."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple no pudo completar el inicio de sesión. Inténtalo más tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple n’a pas pu finaliser la connexion. Réessayez plus tard."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple konnte die Anmeldung nicht abschließen. Versuche es später erneut."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Apple não conseguiu concluir o início de sessão. Tente mais tarde."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر على Apple إكمال تسجيل الدخول. حاول لاحقًا."
          }
        }
      }
    },
    "Apple 暂时无法完成该操作，请稍后重试。": {
