        }
      }
    },
    "下一个下载任务会重新尝试后台下载": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下一个下载任务会重新尝试后台下载"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The next download will try background downloading again"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "下一個下載任務會重新嘗試後臺下載"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次のダウンロードでバックグラウンドダウンロードを再試行します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음 다운로드에서 백그라운드 다운로드를 다시 시도합니다"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Следующая загрузка снова попробует работать в фоне"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La próxima descarga volverá a intentar descargar en segundo plano"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le prochain téléchargement réessaiera en arrière-plan"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der nächste Download versucht es wieder im Hintergrund"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O próximo download tentará novamente em segundo plano"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيحاول التنزيل التالي العمل في الخلفية مجددًا"
          }
        }
      }
    },
    "当前签名下系统后台下载无法保存文件，已自动改用应用内下载，下载时请保持 iPadn 在前台。更换签名后可以点按「重新尝试后台下载」。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前签名下系统后台下载无法保存文件，已自动改用应用内下载，下载时请保持 iPadn 在前台。更换签名后可以点按「重新尝试后台下载」。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With the current signature, the system's background download service can't save files, so downloads now run inside the app. Keep iPadn in the foreground while downloading. After re-signing, tap “Try Background Downloads Again”."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當前簽名下系統後臺下載無法儲存檔案，已自動改用應用內下載，下載時請保持 iPadn 在前臺。更換籤名後可以點一下「重新嘗試後臺下載」。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在の署名ではシステムのバックグラウンドダウンロードがファイルを保存できないため、App 内でのダウンロードに自動で切り替えました。ダウンロード中は iPadn を前面に表示したままにしてください。署名を変更した後は「バックグラウンドダウンロードを再試行」をタップできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 서명으로는 시스템 백그라운드 다운로드가 파일을 저장할 수 없어 앱 내 다운로드로 자동 전환했습니다. 다운로드하는 동안 iPadn을 화면에 띄워 두십시오. 서명을 바꾼 후에는 ‘백그라운드 다운로드 다시 시도’를 탭할 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "С текущей подписью системная служба фоновой загрузки не может сохранять файлы, поэтому загрузка теперь идет внутри приложения. Во время загрузки держите iPadn на экране. После повторной подписи коснитесь «Снова попробовать фоновую загрузку»."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con la firma actual, el servicio de descargas en segundo plano del sistema no puede guardar archivos, así que las descargas se hacen dentro de la app. Mantén iPadn en primer plano mientras descargas. Tras volver a firmar, toca «Volver a probar las descargas en segundo plano»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec la signature actuelle, le service de téléchargement en arrière-plan du système ne peut pas enregistrer de fichiers ; les téléchargements se font donc dans l’app. Gardez iPadn au premier plan pendant le téléchargement. Après une nouvelle signature, touchez « Réessayer les téléchargements en arrière-plan »."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit der aktuellen Signatur kann der Hintergrund-Downloaddienst des Systems keine Dateien sichern, daher laufen Downloads jetzt in der App. Lass iPadn während des Ladens im Vordergrund. Tippe nach dem erneuten Signieren auf „Hintergrund-Downloads erneut versuchen“."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com a assinatura atual, o serviço de download em segundo plano do sistema não consegue salvar arquivos, então os downloads agora ocorrem dentro do app. Mantenha o iPadn em primeiro plano durante o download. Após assinar novamente, toque em “Tentar downloads em segundo plano novamente”."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مع التوقيع الحالي، لا تستطيع خدمة التنزيل في الخلفية في النظام حفظ الملفات، لذا تجري التنزيلات الآن داخل التطبيق. أبقِ iPadn في المقدمة أثناء التنزيل. بعد إعادة التوقيع، اضغط «تجربة التنزيل في الخلفية مجددًا»."
          }
        }
      }
    },
    "检测全部来源": {
      "localizations": {
        "zh-Hans": {
