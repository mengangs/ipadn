          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirmez l’installation dans l’invite du système. Ne quittez pas iPadn avant la fin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
