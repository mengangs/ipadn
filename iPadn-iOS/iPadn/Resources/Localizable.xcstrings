    "登录后可浏览当前 Apple 账号参与的测试版 App，并直接下载或安装。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录后可浏览当前 Apple 账号参与的测试版 App，并直接下载或安装。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to browse beta apps joined by your Apple Account and download or install them directly."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "登入後可瀏覽目前 Apple 帳號參與的測試版 App，並直接下載或安裝。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サインインすると、この Apple アカウントが参加中のベータ版 App を一覧表示し、直接ダウンロード・インストールできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인하면 이 Apple 계정이 참여 중인 베타 앱을 보고 바로 다운로드하거나 설치할 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Войдите, чтобы просматривать бета-приложения вашего аккаунта Apple, скачивать и устанавливать их напрямую."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión para ver las apps beta de tu cuenta de Apple y descargarlas o instalarlas directamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous pour parcourir les apps bêta de votre compte Apple et les télécharger ou installer directement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melde dich an, um Beta-Apps deines Apple Accounts anzuzeigen und direkt zu laden oder zu installieren."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Entre para ver os apps beta da sua conta Apple e baixá-los ou instalá-los diretamente."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجّل الدخول لتصفح التطبيقات التجريبية الخاصة بحساب Apple الخاص بك وتنزيلها أو تثبيتها مباشرة."
          }
        }
      }
    },
